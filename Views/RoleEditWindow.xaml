<Window x:Class="WpfApp1.Views.RoleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        Title="Crear / Editar Rol - SEVICELL" Height="650" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F0F0F0">

    <Window.Resources>
        <Style x:Key="ModuloGroupStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,10">
                            <Expander.Header>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#0097A7" FontSize="14" Margin="5"/>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0097A7" CornerRadius="5,5,0,0" Padding="10">
            <TextBlock Text="CREAR / EDITAR ROL" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#CCCCCC" BorderThickness="1,0,1,1" Padding="15">
            <StackPanel>
                <TextBlock Text="Datos del Rol" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre del Rol:" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtNameRol" Margin="0,0,0,10" Padding="5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Descripción:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDescriptionRol" Padding="5"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#CCCCCC" BorderThickness="1,0,1,1" Padding="15">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Asignar Permisos al Rol" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkSelectAll" 
                              Content="Marcar / Desmarcar Todos" 
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Center"
                              Click="chkSelectAll_Click"/>
                </Grid>

                <ListView x:Name="lvPermisos" BorderThickness="0" Background="Transparent">
                    <ListView.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource ModuloGroupStyle}"/>
                    </ListView.GroupStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="20,2,5,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" Margin="10,0"/>
                                
                                <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" FontSize="13" Margin="0,0"/>

                                <CheckBox Grid.Column="2" IsChecked="{Binding ItemSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnGuardar" Content="GUARDAR" Background="#0097A7" Foreground="White" Width="130" Height="35" FontWeight="Bold" Margin="0,0,10,0" Click="btnGuardar_Click" />
            <Button x:Name="btnCancelar" Content="CANCELAR" Background="#DDDDDD" Width="130" Height="35" Click="btnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>