<Page x:Class="WpfApp1.Views.Sales.SalesInvoiceDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Sales"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SalesInvoiceDetails">

    <Grid Background="#F1F5F9" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnGoBack"
                    Click="BtnGoBack_Click"
                    DockPanel.Dock="Left"
                    Style="{StaticResource btnGoBackStyle}"
                    Cursor="Hand">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="18"/>
            </Button>

            <StackPanel Margin="15,0,0,0">
                <TextBlock Text="Ventas por Día" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Histórico de ventas agrupado por fecha." Foreground="#777" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <!-- TARJETAS DE MÉTRICAS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#f6fff8" CornerRadius="8" Padding="15" >
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" Margin="30,5">
                    <TextBlock Foreground="#0077b6" FontWeight="SemiBold" FontSize="15" Text="Total en Ventas"/>
                    <TextBlock Foreground="#03045e" x:Name="TxtTotalEfectivo" FontSize="22" FontFamily="Segoe UI Semibold" Text="L. 0.00" Margin="5,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#f6fff8" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" Margin="30,5">
                    <TextBlock Foreground="#0077b6" FontWeight="SemiBold" FontSize="15" Text="Dias con Venta"/>
                    <TextBlock Foreground="#fb8500" x:Name="TxtDiasConVentas" FontSize="22" FontFamily="Segoe UI Semibold" Text="0" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="#f6fff8" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" Margin="30,5">
                    <TextBlock Foreground="#0077b6" FontWeight="SemiBold" FontSize="15" Text="Promedio por día"/>
                    <TextBlock Foreground="#3c6e71"  x:Name="TxtPromedioPorDia" FontSize="22" FontFamily="Segoe UI Semibold" Text="L. 0.00" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FILTRO AÑO / MES -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Año" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboAnio"
                              Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Mes" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboMes"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Tipo de Venta" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboTipoVenta"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="3" Name="BtnBuscar" Content="🔍 Buscar" Width="120" Height="38" VerticalAlignment="Bottom"
                        Background="#2563EB" Foreground="White" FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Click="BtnBuscar_Click"/>
            </Grid>
        </Border>

        <!-- NIVEL 1 (izquierda) + NIVEL 2 (derecha) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.6*"/>
            </Grid.ColumnDefinitions>

            <!-- NIVEL 1: LISTA DE DÍAS -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                </Border.Effect>
                <DataGrid x:Name="DgDias"
                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#F8FAFC"
                          BorderThickness="0" Foreground="#1E293B" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0" HeadersVisibility="Column"
                          AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="46"
                          IsReadOnly="True" SelectionChanged="DgDias_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*"/>
                        <DataGridTextColumn Header="VENTAS" Binding="{Binding InvoiceCount}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,15,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#2563EB"/>
                                    <Setter Property="Margin" Value="0,0,15,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- NIVEL 2: FACTURAS DEL DÍA SELECCIONADO -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <TextBlock x:Name="TxtSinSeleccion"
                       Text="Seleccione un día para ver sus facturas."
                       Foreground="#94A3B8" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <DataGrid x:Name="DgFacturasDelDia" Visibility="Collapsed"
                              Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0" Foreground="#1E293B" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" HeadersVisibility="Column"
                              AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="42"
                              IsReadOnly="True">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° FACTURA" Binding="{Binding InvoiceNumber}" Width="*"/>
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding CustomerDisplay}" Width="*"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#2563EB"/>
                                        <Setter Property="Margin" Value="0,0,15,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- NIVEL 3: BOTÓN QUE ABRE LA VENTANA MODAL -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Detalles" Width="90" Height="28"
                                                Background="#EFF6FF" Foreground="#1E40AF" BorderBrush="Transparent"
                                                FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                                Click="BtnDetalles_Click" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
