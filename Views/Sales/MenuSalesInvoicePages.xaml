<Page x:Class="WpfApp1.Views.Sales.MenuSalesInvoicePages"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Sales"
       xmlns:fa5="http://schemas.fontawesome.com/icons/"
      
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MenuSalesInvoicePages">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Administración de las ventas" FontSize="28" FontWeight="Bold" Foreground="#2D2D30"/>
            <TextBlock Text="Control y auditoria de las ventas" Foreground="Gray" FontSize="14"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Top">

            <Button x:Name="btnSells" Click="btnSells_Click" Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_FolderOpen" Height="50" Foreground="#023047" Margin="0,0,0,15"/>
                    <TextBlock Text="Fact. Ventas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Registro de Facts. de Ventas." Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnHistorySells" Click="BtnHistorySells_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_History" Height="50" Foreground="#ffb703" Margin="0,0,0,15"/>
                    <TextBlock Text="Historico de ventas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Visualización de fact. Ventas" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnSellsDaily" Click="BtnSellsDaily_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_ListAlt" Height="50" Foreground="#fb8500" Margin="0,0,0,15"/>
                    <TextBlock Text="Ventas por día" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Historico de Ventas" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</Page>
