<Page x:Class="WpfApp1.Views.OptionCatalogoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      Title="Panel de Catálogos">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Cátalogos" FontSize="28" FontWeight="Bold" Foreground="#2D2D30"/>
            <TextBlock Text="Administre Categorias, Marcas, proveedores y Clientes." Foreground="Gray" FontSize="14"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Top">

            <Button x:Name="btnCategories" Click="btnCategories_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_Tags" Height="50" Foreground="#3F51B5" Margin="0,0,0,15"/>
                    <TextBlock Text="Categorías y Marcas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Administración de marcas y categorías" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnSuppliers" Click="btnSuppliers_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_Handshake" Height="50" Foreground="#FF5722" Margin="0,0,0,15"/>
                    <TextBlock Text="Proveedores" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Información de distribuidores mayoristas" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnClientes" Click="BtnClientes_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_Users" Height="50" Foreground="#FF9800" Margin="0,0,0,15"/>
                    <TextBlock Text="Clientes" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ver movimientos del sistema" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

        </UniformGrid>
    </Grid>
</Page>
