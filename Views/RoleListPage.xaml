<Page x:Class="WpfApp1.Views.RoleListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Gestión de Roles">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnGoBack" Click="BtnGoBack_Click"
                    Style="{StaticResource btnGoBackStyle}"
                    DockPanel.Dock="Left"  Cursor="Hand">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="20" Foreground="#2196F3"/>
            </Button>

            <StackPanel Margin="15,0,0,0">
                <TextBlock Text="Módulo de Roles" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Administre y Visualice la información de los roles." Foreground="#777" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtBuscar" Grid.Column="0" Style="{StaticResource SearchTextBoxStyle}"/>
            <Button x:Name="BtnAddRole" Click="BtnAddRole_Click"  Grid.Column="2" Background="#2196F3" BorderThickness="0" Cursor="Hand" Padding="15,8">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Plus" Height="14" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Nuevo Registro" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <DataGrid x:Name="dgRoles"  Grid.Row="2" AutoGenerateColumns="False" Style="{StaticResource ModernDataGrid}" 
               CanUserAddRows="False" HeadersVisibility="Column"
               GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
               BorderThickness="0"
               BorderBrush="#DDDDDD"
               Background="White" RowHeight="44" FontSize="13">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>

                <DataGridTextColumn Header="TIPO DE ROL" Binding="{Binding name}" Width="*"/>

                <DataGridTemplateColumn Header="ESTADO"  Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,16,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border x:Name="StockBadge" Style="{StaticResource BadgeBorderStyle}">
                                    <TextBlock x:Name="statusText" 
                         Text="{Binding status}" 
                         Style="{StaticResource BadgeTextStyle}"
                         FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding status}" Value="Deshabilitado">
                                    <Setter TargetName="StockBadge" Property="Background" Value="#FDEDEC"/>
                                    <Setter TargetName="statusText" Property="Foreground" Value="#C0392B"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding status}" Value="Activo">
                                    <Setter TargetName="StockBadge" Property="Background" Value="#E8F8F5"/>
                                    <Setter TargetName="statusText" Property="Foreground" Value="#117A65"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ACCIONES" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnEdit" Click="BtnEdit_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="20,0,10,0">
                                    <fa5:SvgAwesome Icon="Solid_Edit" Height="14" Foreground="Orange"/>
                                </Button>
                                <Button x:Name="BtnDisable" Click="BtnDisable_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,0">
                                    <fa5:SvgAwesome Height="14">
                                        <fa5:SvgAwesome.Style>
                                            <Style TargetType="{x:Type fa5:SvgAwesome}">
                                                <Setter Property="Icon" Value="Solid_Trash" />
                                                <Setter Property="Foreground" Value="Red" />
                                                <Setter Property="ToolTip" Value="Dar de baja" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding status}" Value="Deshabilitado">
                                                        <Setter Property="Icon" Value="Solid_UserCheck" />
                                                        <Setter Property="Foreground" Value="Green" />
                                                        <Setter Property="ToolTip" Value="Habilitar usuario" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </fa5:SvgAwesome.Style>
                                    </fa5:SvgAwesome>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>

</Page>
