<Page x:Class="WpfApp1.Views.ConfigDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      Title="Panel de Seguridad"
      Background="Transparent">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Seguridad y Sistema" FontSize="28" FontWeight="Bold" Foreground="#2D2D30"/>
            <TextBlock Text="Administre los accesos y perfiles de SEVICELL Pro" Foreground="Gray" FontSize="14"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Top">
            
            <Button x:Name="btnUsers" Click="btnUsers_Click" Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_UserShield" Height="50" Foreground="#2196F3" Margin="0,0,0,15"/>
                    <TextBlock Text="Usuarios" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Altas, bajas y edición" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="rol" Click="rol_Click" Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_UserTag" Height="50" Foreground="#4CAF50" Margin="0,0,0,15"/>
                    <TextBlock Text="Roles de Sistema" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Definir niveles de acceso" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_History" Height="50" Foreground="#FF9800" Margin="0,0,0,15"/>
                    <TextBlock Text="Auditoría" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ver movimientos del sistema" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            
        </UniformGrid>
    </Grid>
</Page>