<Window x:Class="WpfApp1.Views.Credit.HistorialPagosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico de pagos" Height="520" Width="500"
        Background="#F1F5F9"
        xmlns:local="clr-namespace:WpfApp1.Views.Credit"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo" Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,16"/>
        <local:HistorialPagosView x:Name="Vista" Grid.Row="1"/>
    </Grid>
</Window>