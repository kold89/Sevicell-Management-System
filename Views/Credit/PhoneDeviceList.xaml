<Page x:Class="WpfApp1.Views.Credit.PhoneDeviceList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      xmlns:local="clr-namespace:WpfApp1.Views.Credit"
      mc:Ignorable="d" 
      xmlns:ctrl="clr-namespace:WpfApp1.ControlsUI"
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Title="PhoneDeviceList">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnGoBack" 
                    Click="BtnGoBack_Click" 
                    DockPanel.Dock="Left" 
                    Style="{StaticResource btnGoBackStyle}"
                    Cursor="Hand">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="18"/>
            </Button>

            <StackPanel Margin="15,0,0,0">
                <TextBlock Text="Módulo de Dispositivos." FontSize="22" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Búsqueda y verificación de datos de cada dispositivo." Foreground="#777" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <!-- FILTROS -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Estado de dispositivo." Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboFilterStatus"
                              DisplayMemberPath="name"
                              SelectedValuePath="id"
                              Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Modelo / IMEI" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtFiltroNumero" Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" 
                             FontSize="14" VerticalContentAlignment="Center" Padding="8,0"
                             KeyDown="TxtFiltroNumero_KeyDown"/>
                </StackPanel>

                <Button Name="BtnBuscar" Grid.Column="2" Content="🔍 Buscar" Width="120" Height="38" VerticalAlignment="Bottom"
                        Background="#2563EB" Foreground="White" FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,0,5" Click="BtnBuscar_Click"/>
            </Grid>
        </Border>

        <!-- BODY / DATAGRID -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <!-- DataGrid principal (su visibilidad la controla MostrarEstado en el code-behind) -->
                <DataGrid x:Name="DgUnidades"
                          ItemsSource="{Binding Unidades}"
                          Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#F8FAFC"
                          BorderThickness="0" Foreground="#1E293B" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0" HeadersVisibility="Column"
                          AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="44"
                          FontSize="13" IsReadOnly="True">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Name}" Width="1.6*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="16,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="IMEI" Binding="{Binding Imei}" Width="1.6*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="16,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="IMEI2" Binding="{Binding Imei2}" Width="1.4*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="COLOR" Binding="{Binding Colour}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="1.2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="ESTADO" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF9E7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Disponible">
                                                        <Setter Property="Background" Value="#E8F8F5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Vendido">
                                                        <Setter Property="Background" Value="#FDEDEC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#B7950B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disponible">
                                                            <Setter Property="Foreground" Value="#117A65"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Vendido">
                                                            <Setter Property="Foreground" Value="#C0392B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACCIONES" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnDetails" Click="BtnDetails_Click"
                                                Background="Transparent" ToolTip="Ver detalle"
                                                BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Reservado">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Opacity" Value="0.35"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <fa5:SvgAwesome Icon="Solid_Eye" Height="14" Foreground="#117A65"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- PANEL DE ESTADO VACÍO / ERROR (lo controla MostrarEstado en el code-behind) -->
                <StackPanel x:Name="PnlEmptyState" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                    <TextBlock x:Name="TxtEmptyTitle" FontSize="16" FontWeight="SemiBold" Foreground="#475569" 
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtEmptySub" FontSize="13" Foreground="#94A3B8" 
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER: resumen + paginador -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtResumen" Grid.Column="0" Margin="4,0,0,0"
               VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>

            <ctrl:PaginadorControl x:Name="Paginador" Grid.Column="1"
                           RegistrosPorPagina="10"
                           PaginaCambiada="Paginador_PaginaCambiada"/>
        </Grid>
    </Grid>
</Page>
