<Page x:Class="WpfApp1.Views.Credit.PhoneDeviceList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
      xmlns:local="clr-namespace:WpfApp1.Views.Credit"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Title="PhoneDeviceList">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!--HEADER-->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnGoBack" 
        Click="BtnGoBack_Click" 
        DockPanel.Dock="Left" 
        Style="{StaticResource btnGoBackStyle}"
        Cursor="Hand">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="18"/>
            </Button>

            <StackPanel Margin="15,0,0,0">
                <TextBlock Text="Módulo de Dispositivos." FontSize="22" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Busqueda y verificación de datos de cada dispositivo." Foreground="#777" FontSize="13"/>
            </StackPanel>
        </DockPanel>
        <!-- FILTROS -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Estado de dispositivo." Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboFilteStatus"
                      DisplayMemberPath="name"
                      SelectedValuePath="id"
                      Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Modelo / IMEI" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtFiltroNumero" Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" FontSize="14" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>

                <Button Name="BtnBuscar" Grid.Column="2" Content="🔍 Buscar" Width="120" Height="38" VerticalAlignment="Bottom"
                Background="#2563EB" Foreground="White" FontSize="13" FontWeight="SemiBold"
                BorderThickness="0" Cursor="Hand" Margin="0,0,0,5" Click="BtnBuscar_Click"/>

            </Grid>
        </Border>
        <!--BODY/DATAGRID-->
        <DataGrid Grid.Row="2" 
          x:Name="DgUnidades"
          ItemsSource="{Binding Unidades}"
          Style="{StaticResource ModernDataGrid}"
          AutoGenerateColumns="False"
          HeadersVisibility="Column"
          IsReadOnly="True"
          GridLinesVisibility="Horizontal"
          BorderThickness="0"
          BorderBrush="#DDDDDD"
          Background="White"
          RowHeight="44"
          FontSize="13"
          CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Name}" Width="1.6*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="16,0,0,0"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <DataGridTextColumn Header="IMEI" Binding="{Binding Imei}" Width="1.6*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="16,0,0,0"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="IMEI2" Binding="{Binding Imei2}" Width="1.4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="Foreground" Value="#7F8C8D"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="COLOR" Binding="{Binding Colour}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="MODELO" Binding="{Binding Model}" Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="ESTADO" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,16,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border x:Name="StatusBadge" Style="{StaticResource BadgeBorderStyle}">
                                    <TextBlock x:Name="StatusText"
                                       Text="{Binding Status}"
                                       Style="{StaticResource BadgeTextStyle}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Disponible">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#E8F8F5"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#117A65"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Vendido">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#FDEDEC"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#C0392B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Reservado">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#FEF9E7"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#B7950B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="ACCIONES" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnDetails" Click="BtnDetails_Click"  Width="30"
                        Height="30" Margin="3"
                        Background="#F5F5F5"
                        BorderBrush="Transparent"
                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Reservado">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <fa5:SvgAwesome Icon="Solid_Eye" Height="14" Foreground="Orange"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        <!--FOOTER-->
    </Grid>
</Page>
