<Window x:Class="WpfApp1.Views.Credit.CuotasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuotas del contrato" Height="520" Width="500"
        Background="#F1F5F9"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo" Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
            </Border.Effect>
            <DataGrid x:Name="DgCuotas"
                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0" Foreground="#1E293B" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" HeadersVisibility="Column"
                      AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40"
                      IsReadOnly="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CUOTA" Binding="{Binding InstallmentNumber}" Width="55">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="VENCE" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="90"/>
                    <DataGridTextColumn Header="MONTO" Binding="{Binding ExpectedAmount, StringFormat='L. {0:N2}'}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="SALDO" Binding="{Binding SaldoPendiente, StringFormat='L. {0:N2}'}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="ESTADO" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="PAGADO">
                                                    <Setter Property="Background" Value="#E8F8F5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="PAGO_TARDE">
                                                    <Setter Property="Background" Value="#E8F8F5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="VENCIDO">
                                                    <Setter Property="Background" Value="#FDEDEC"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="CONDONADO">
                                                    <Setter Property="Background" Value="#E5E7EB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#B45309"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="PAGADO">
                                                        <Setter Property="Foreground" Value="#117A65"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="PAGO_TARDE">
                                                        <Setter Property="Foreground" Value="#117A65"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="VENCIDO">
                                                        <Setter Property="Foreground" Value="#C0392B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="CONDONADO">
                                                        <Setter Property="Foreground" Value="#4B5563"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>