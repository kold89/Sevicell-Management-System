<Window x:Class="WpfApp1.Views.Credit.PagoAbonoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views.Credit"
        mc:Ignorable="d"
        Title="Registrar pago" Height="320" Width="380" ResizeMode="NoResize">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtTitulo" Text="Registrar pago"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="TxtSubtitulo" Foreground="#64748B" FontSize="13" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="2" Text="Saldo pendiente de esta cuota" FontSize="12" Foreground="#64748B"/>
        <TextBlock Grid.Row="2" x:Name="TxtSaldo" HorizontalAlignment="Right"
                   FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Monto a pagar" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtMonto" FontSize="16" Padding="8" Height="38"
                     PreviewTextInput="TxtMonto_PreviewTextInput"
                     TextChanged="TxtMonto_TextChanged"/>
            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Width="90" Height="34" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button x:Name="BtnConfirmar" Content="Confirmar" Width="100" Height="34"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Click="BtnConfirmar_Click"/>
        </StackPanel>
    </Grid>
</Window>
