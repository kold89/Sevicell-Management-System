<Window x:Class="WpfApp1.Views.Credit.RegistrarPagoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views.Credit"
        mc:Ignorable="d"
        Background="#F1F5F9" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Title="Registrar pago" Height="520" Width="400">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Registrar pago" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,2"/>
        <TextBlock Grid.Row="1" x:Name="TxtSubtitulo" FontSize="13" Foreground="#64748B" Margin="0,0,0,16"/>

        <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <Grid>
                <TextBlock Text="Saldo pendiente del contrato" FontSize="13" Foreground="#64748B"/>
                <TextBlock x:Name="TxtSaldoTotal" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="Monto a pagar" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtMonto" FontSize="14" Padding="6"
                     PreviewTextInput="TxtMonto_PreviewTextInput"
                     TextChanged="TxtMonto_TextChanged"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Cuota más antigua" Click="BtnCuota_Click" Padding="10,4" Margin="0,0,8,0"/>
                <Button Content="Saldo total" Click="BtnTodo_Click" Padding="10,4"/>
            </StackPanel>
            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Se aplicará en este orden" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="IcCuotas">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <Grid>
                                <TextBlock Text="{Binding Etiqueta}" FontSize="13" Foreground="#1E293B"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding MontoTexto}" FontSize="13" Foreground="#64748B" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding EstadoTexto}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding EstadoColor}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" Width="90" Height="34" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button x:Name="BtnConfirmar" IsDefault="True" Content="Confirmar Pago" Width="140" Height="34"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Click="BtnConfirmar_Click"/>
        </StackPanel>
    </Grid>
</Window>
