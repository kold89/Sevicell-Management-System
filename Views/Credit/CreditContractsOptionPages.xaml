<Page x:Class="WpfApp1.Views.Credit.CreditContractsOptionPages"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Credit"
       xmlns:fa5="http://schemas.fontawesome.com/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreditContractsOptionPages">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Control y gestión de contratos de credito" FontSize="28" FontWeight="Bold" Foreground="#2D2D30"/>
            <TextBlock Text="Administración y visualizacion detallada de lo relacionado a los contratos." Foreground="Gray" FontSize="14"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Top">

            <Button x:Name="BtnContracts" Click="BtnContracts_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_FileSignature"  Height="50" Foreground="#607D8B" Margin="0,0,0,15"/>
                    <TextBlock Text="Contratos" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Alta y administración de contratos." Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnCategories"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_MoneyBillAlt" Height="50" Foreground="#3F51B5" Margin="0,0,0,15"/>
                    <TextBlock Text="Categorías y Marcas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Administración de marcas y categorías" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnPurchases" Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_TruckLoading" Height="50" Foreground="#FF9800" Margin="0,0,0,15"/>
                    <TextBlock Text="Entrada por Compras" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ingresar facturas de proveedores" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>

</Page>
