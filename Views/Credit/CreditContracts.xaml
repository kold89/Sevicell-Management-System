<Page x:Class="WpfApp1.Views.Credit.CreditContracts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Credit"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      Title="CreditContracts">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnGoBack"
                   
                    DockPanel.Dock="Left"
                    Style="{StaticResource btnGoBackStyle}"
                    Cursor="Hand">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="18"/>
            </Button>
            <StackPanel Margin="15,0,0,0">
                <TextBlock Text="Contratos de crédito"
                           FontSize="22" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Ventas de teléfonos a plazos"
                           Foreground="#777" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <!-- Métricas -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Contratos activos -->
            <Border Grid.Column="0" Background="#f6fff8"
                    BorderBrush="#EEEEEE" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Contratos activos"
                               FontSize="12" Foreground="#888"/>
                    <TextBlock x:Name="LblTotalContracts"
                               Text="23"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#333" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <fa5:SvgAwesome Icon="Solid_Circle"
                                        Height="8" Foreground="#2ECC71"
                                        Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Vigentes"
                                   FontSize="11" Foreground="#888"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Por cobrar -->
            <Border Grid.Column="1" Background="#f6fff8"
                    BorderBrush="#EEEEEE" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="Por cobrar"
                               FontSize="12" Foreground="#888"/>
                    <TextBlock x:Name="LblTotalPending"
                               Text="L. 48,200"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#333" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <fa5:SvgAwesome Icon="Solid_MoneyBill"
                                        Height="8" Foreground="#3498DB"
                                        Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Saldo total"
                                   FontSize="11" Foreground="#888"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Cuotas vencidas -->
            <Border Grid.Column="2" Background="#f6fff8"
                    BorderBrush="#EEEEEE" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="Cuotas vencidas"
                               FontSize="12" Foreground="#888"/>
                    <TextBlock x:Name="LblOverdue"
                               Text="3"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#E74C3C" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <fa5:SvgAwesome Icon="Solid_ExclamationTriangle"
                                        Height="8" Foreground="#E74C3C"
                                        Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Requieren atención"
                                   FontSize="11" Foreground="#E74C3C"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Vencen esta semana -->
            <Border Grid.Column="3" Background="#f6fff8"
                    BorderBrush="#EEEEEE" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Vencen esta semana"
                               FontSize="12" Foreground="#888"/>
                    <TextBlock x:Name="LblDueSoon"
                               Text="5"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#F39C12" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <fa5:SvgAwesome Icon="Solid_Clock"
                                        Height="8" Foreground="#F39C12"
                                        Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Próximos 7 días"
                                   FontSize="11" Foreground="#888"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Buscador -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Style="{StaticResource SearchTextBoxStyle}"
                     x:Name="TxtSearch"/>
            <Button Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Background="#2196F3"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="15,8"
                    Width="150">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Plus" Height="14"
                                    Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Nuevo contrato"
                               Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>

        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="DgContracts"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  Style="{StaticResource ModernDataGrid}"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#F0F0F0"
                  BorderThickness="1"
                  BorderBrush="#DDDDDD"
                  Background="White"
                  RowHeight="50"
                  FontSize="13">

            <DataGrid.Columns>

                <!-- Cliente con avatar -->
                <DataGridTemplateColumn Header="Cliente" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <Border Width="32" Height="32"
                                        CornerRadius="16"
                                        Background="{Binding AvatarColor}"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Initials}"
                                               Foreground="{Binding AvatarTextColor}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding CustomerName}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#333"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Equipo -->
                <DataGridTextColumn Header="Equipo"
                                    Binding="{Binding DeviceName}"
                                    Width="150"/>

                <!-- Cuota mensual -->
                <DataGridTextColumn Header="Cuota mensual"
                                    Binding="{Binding InstallmentAmount}"
                                    Width="130"/>

                <!-- Cuotas pagadas -->
                <DataGridTextColumn Header="Avance"
                                    Binding="{Binding Progress}"
                                    Width="100"/>

                <!-- Próximo pago -->
                <DataGridTextColumn Header="Próximo pago"
                                    Binding="{Binding NextPayment}"
                                    Width="130"/>

                <!-- Estado badge -->
                <DataGridTemplateColumn Header="Estado" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BadgeBackground}"
                                    CornerRadius="10"
                                    Padding="10,3"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0">
                                <TextBlock Text="{Binding Status}"
                                           Foreground="{Binding BadgeText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Acciones -->
                <DataGridTemplateColumn Header="Acciones" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                <Button 
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand" Margin="0,0,10,0"
                                        ToolTip="Ver contrato">
                                    <fa5:SvgAwesome Icon="Solid_Eye"
                                                    Height="14" Foreground="#3498DB"/>
                                </Button>
                                <Button 
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Registrar pago">
                                    <fa5:SvgAwesome Icon="Solid_DollarSign"
                                                    Height="14" Foreground="#2ECC71"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
