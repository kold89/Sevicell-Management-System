<Page x:Class="WpfApp1.Views.Credit.CreditContracts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Credit"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      xmlns:controles="clr-namespace:WpfApp1"
      Title="CreditContracts">

    <Grid Background="#F1F5F9" Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="141*"/>
            <ColumnDefinition Width="44*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20" Grid.ColumnSpan="2">
            <Button x:Name="BtnGoBack"
                    Click="BtnGoBack_Click"
                    DockPanel.Dock="Left"
                    Style="{StaticResource btnGoBackStyle}"
                    Cursor="Hand">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="18"/>
            </Button>
            <StackPanel Margin="15,0,0,0">
                <TextBlock Text="Nuevo contrato de crédito"
                           FontSize="22" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Ventas de teléfonos a plazos"
                           Foreground="#777" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2" Margin="0,0,0,0">
            <StackPanel>

                <!-- FILA 1: VENDEDOR + CLIENTE -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- === VENDEDOR === -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa5:SvgAwesome Icon="Solid_UserTie" Height="14" Foreground="#2563EB" Margin="0,0,8,0"/>
                                <TextBlock Text="Vendedor" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <TextBlock Text="Seleccionar vendedor" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbVendedor"
                                      DisplayMemberPath="name"
                                      SelectedValuePath="id"
                                      SelectionChanged="cmbVendedor_SelectionChanged"
                                      Height="36" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="13" VerticalContentAlignment="Center"/>

                            <!-- Info del cliente seleccionado -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                <TextBlock x:Name="txtInfoVendedor"
                                  Text="Dirección: —&#x0a;Tel: —"
                                  FontSize="11.5"
                                  Foreground="#475569"
                                  LineHeight="18"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- === CLIENTE === -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa5:SvgAwesome Icon="Solid_User" Height="14" Foreground="#2563EB" Margin="0,0,8,0"/>
                                <TextBlock Text="Cliente" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <TextBlock Text="Seleccionar cliente" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                            <DockPanel LastChildFill="True">
                                <Button x:Name="btnNuevoCliente"
                                        Click="btnNuevoCliente_Click"
                                        Content="+ Nuevo"
                                        DockPanel.Dock="Right"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Padding="12,0"
                                        Background="#2563EB"
                                        Foreground="White"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                                <ComboBox x:Name="cmbCliente"
                                          DisplayMemberPath="name"
                                          SelectedValuePath="id"
                                          SelectionChanged="cmbCliente_SelectionChanged"
                                          Height="36" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="13" VerticalContentAlignment="Center"/>
                            </DockPanel>

                            <!-- Info del cliente seleccionado -->
                            <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                <TextBlock x:Name="txtInfoCliente"
                                           Text="Dirección: —&#x0a;Tel: —"
                                           FontSize="11.5"
                                           Foreground="#475569"
                                           LineHeight="18"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FILA 2: TELÉFONO + FINANCIAMIENTO -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- === TELÉFONO / PRODUCTO === -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa5:SvgAwesome Icon="Solid_Mobile" Height="14" Foreground="#2563EB" Margin="0,0,8,0"/>
                                <TextBlock Text="Teléfono / unidad" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                            <TextBlock Text="Unidad disponible" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbProducto"
                                      DisplayMemberPath="name"
                                      SelectedValuePath="id"
                                      SelectionChanged="cmbProducto_SelectionChanged"
                                      Height="36" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="13" VerticalContentAlignment="Center"/>

                            <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                <!-- Info del telefono seleccionado -->
                                <Border Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                    <TextBlock x:Name="txtInfoPhone"
                                        Text="Dirección: —&#x0a;Tel: —"
                                        FontSize="11.5"
                                        Foreground="#475569"
                                        LineHeight="18"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- === FINANCIAMIENTO === -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa5:SvgAwesome Icon="Solid_MoneyBillWave" Height="14" Foreground="#2563EB" Margin="0,0,8,0"/>
                                <TextBlock Text="Financiamiento" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Precio -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,6,10">
                                    <TextBlock Text="Precio venta" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <controles:PriceTexBox x:Name="txtPrecioVenta"
                                                            
                                                            Height="34" Background="#F8FAFC" BorderBrush="#CBD5E1"
                                                            Foreground="#1E293B" FontSize="13"
                                                            VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                            Text="950.00"/>
                                </StackPanel>

                                <!-- Inicial -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Margin="6,0,0,10">
                                    <TextBlock Text="Prima / Enganche" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <controles:PriceTexBox x:Name="txtCuotaInicial"
                                                            
                                                            Height="34" Background="#F8FAFC" BorderBrush="#CBD5E1"
                                                            Foreground="#1E293B" FontSize="13"
                                                            VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                                                            Text="200.00"/>
                                </StackPanel>
                              
                                <!-- Cuotas -->
                                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,6,10">
                                    <TextBlock Text="N° cuotas" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <controles:IntTexBox x:Name="txtNumCuotas"                         
           Height="34" Background="#F8FAFC" BorderBrush="#CBD5E1"
           Foreground="#1E293B" FontSize="13"
           VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
           Text="12"/>
                                </StackPanel>

                                <!-- Frecuencia -->
                                <StackPanel Grid.Column="1" Grid.Row="1" Margin="6,0,0,10">
                                    <TextBlock Text="Frecuencia" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbFrecuencia"
                                              DisplayMemberPath="name"
                                              SelectedValuePath="id"
                                              Height="34" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="13"
                                              VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <!-- Frecuencia -->

                                <!-- 1er vencimiento -->
                                <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,6,0">
                                    <TextBlock Text="1er vencimiento" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="dpPrimerVencimiento"
                                                
                                                Height="34" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="13"/>
                                </StackPanel>

                            
                                <!--Tasa de interes-->
                                <StackPanel Grid.Column="1" Grid.Row="2" Margin="6,0,0,10">
                                    <TextBlock Text="Tasa" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbTasa"
           DisplayMemberPath="description"
           SelectedValuePath="id"
           Height="34" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="13"
           VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <!-- === RESUMEN === -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <fa5:SvgAwesome Icon="Solid_ChartBar" Height="14" Foreground="#2563EB" Margin="0,0,8,0"/>
                                <TextBlock Text="Resumen del contrato" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>

                            <!-- Fila 1: montos principales -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock FontSize="13" Foreground="#374151" Margin="0,0,24,0">
                                    <Run Text="Precio: "/>
                                    <Run x:Name="runResumenPrecio" Text="L. 0.00" FontWeight="SemiBold" Foreground="#111827"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="13" Foreground="#374151" Margin="0,0,24,0">
                                    <Run Text="Prima / Enganche: "/>
                                    <Run x:Name="runResumenInicial" Text="L. 0.00" FontWeight="SemiBold" Foreground="#111827"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="13" Foreground="#DC2626" Margin="0,0,24,0">
                                    <Run Text="Saldo a financiar: "/>
                                    <Run x:Name="runResumenSaldo" Text="L. 0.00" FontWeight="SemiBold"/>
                                </TextBlock>
                                                   
                             </StackPanel>

                                                <!-- Fila 2: detalles del plan -->
                                                <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="13" Foreground="#059669" Margin="0,0,24,0">
                                    <Run Text="Pago Cuota: "/>
                                    <Run x:Name="runResumenCuotaMonto" Text="L. 0.00" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock FontSize="13" Foreground="#374151" Margin="0,0,24,0">
                                    <Run Text="Total cuotas: "/>
                                    <Run x:Name="runResumenCuotas" Text="-" FontWeight="SemiBold" Foreground="#111827"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="13" Foreground="#374151">
                                    <Run Text="Último vencimiento: "/>
                                    <Run x:Name="runResumenVencimiento" Text="---" FontWeight="SemiBold" Foreground="#111827"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- === BOTONES === -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"  Margin="0,0,0,4">
                        <Button x:Name="btnCancelar"
                           Click="btnCancelar_Click"
                           Content="Cancelar"
                           Width="110" Height="42"
                           Margin="0,0,12,0"
                           Background="White"
                           Foreground="#64748B"
                           BorderBrush="#CBD5E1"
                           BorderThickness="1"
                           FontSize="13" FontWeight="SemiBold"
                           Cursor="Hand"/>
                                    <Button x:Name="btnGuardar"
                           Click="btnGuardar_Click"
                           Content="Guardar contrato"
                           Width="180" Height="42"
                           Background="#2563EB"
                           Foreground="White"
                           BorderThickness="0"
                           FontSize="13" FontWeight="Bold"
                           Cursor="Hand"/>
                    </StackPanel>

                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
