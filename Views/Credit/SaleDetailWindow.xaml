<Window x:Class="WpfApp1.Views.Credit.SaleDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views.Credit"
        mc:Ignorable="d"
        Title="Detalle del contrato" Height="440" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F1F5F9">
    <Border Margin="16" Background="#F8F8F8" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Color="#000000" Opacity="0.08" ShadowDepth="3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Detalle de la venta." FontSize="18" FontWeight="Bold"
                       Foreground="#1E293B" Margin="0,0,0,20"/>

            <!-- Cliente con iniciales -->
            <DockPanel Grid.Row="1" Margin="0,0,0,16">
                <Border Width="48" Height="48" CornerRadius="24" Background="#2563EB" DockPanel.Dock="Left">
                    <TextBlock x:Name="TxtIniciales" FontWeight="Bold" FontSize="15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCliente" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock x:Name="txtDetailsCliente" FontSize="12" Foreground="#94A3B8"/>
                    <TextBlock Text="Cliente" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
            </DockPanel>

            <Separator Grid.Row="2" Margin="0,0,0,16" Background="#DDDDDD"/>

            <StackPanel Grid.Row="3">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="N. contrato" Foreground="#64748B" FontSize="13"/>
                    <TextBlock x:Name="TxtNumeroContrato" Grid.Column="1" HorizontalAlignment="Right"
                               FontWeight="SemiBold" Foreground="#1E293B" FontSize="13"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Fecha de inicio" Foreground="#64748B" FontSize="13"/>
                    <TextBlock x:Name="TxtFechaInicio" Grid.Column="1" HorizontalAlignment="Right"
                               Foreground="#334155" FontSize="13"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Dispositivo" Foreground="#64748B" FontSize="13"/>
                    <TextBlock x:Name="TxtDispositivo" Grid.Column="1" HorizontalAlignment="Right"
                               Foreground="#334155" FontSize="13" TextWrapping="Wrap" TextAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="IMEI" Foreground="#64748B" FontSize="13"/>
                    <TextBlock x:Name="TxtImei" Grid.Column="1" HorizontalAlignment="Right"
                               FontFamily="Consolas" Foreground="#334155" FontSize="13"/>
                </Grid>
            </StackPanel>

            <Button Grid.Row="4" Content="Cerrar" Click="BtnCerrar_Click" Height="40"
                    Background="#2563EB" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand" Margin="0,8,0,0"/>
        </Grid>
    </Border>
</Window>