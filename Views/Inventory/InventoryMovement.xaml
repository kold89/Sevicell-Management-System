<Page x:Class="WpfApp1.Views.Inventory.InventoryMovement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InventoryMovement">

    <Grid Margin="25" xmlns:fa5="http://schemas.fontawesome.com/icons/">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- RECURSOS LOCALES: Estilos y Triggers visuales para los Badges de Estado -->
        <Grid.Resources>
            <!-- Estilo Base para los Badges Redondeados en las Tablas -->
            <Style TargetType="Border" x:Key="BadgeBorderStyle">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBlock" x:Key="BadgeTextStyle">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <!-- Estilos para los Headers del DataGrid (Consistencia Visual) -->
            <Style TargetType="DataGridColumnHeader" x:Key="GridHeaderStyle">
                <Setter Property="Background" Value="#F8F9F9"/>
                <Setter Property="Foreground" Value="#34495E"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="#BDC3C7"/>
            </Style>
        </Grid.Resources>

        <!-- ROW 0: ENCABEZADO PRINCIPAL (Título y Subtítulo) -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnGoBack" Click="BtnGoBack_Click" DockPanel.Dock="Left" 
                Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="18" Foreground="#2196F3"/>
            </Button>

            <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Módulo de Reajuste Híbrido" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Busque el repuesto y ajústelo directamente o consulte la auditoría de mermas" Foreground="#7F8C8D" FontSize="13" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ROW 1: BARRA DE BÚSQUEDA DINÁMICA -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Buscador Estilizado con Icono -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#BDC3C7" BorderThickness="1" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <fa5:SvgAwesome Icon="Solid_Search" Height="14" Foreground="#95A5A6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtBuscar" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center"
                         FontSize="14" Foreground="#34495E" Background="Transparent"
                         ToolTip="Escriba el nombre del repuesto, categoría o motivo del ajuste."/>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: CONTENEDOR OPERATIVO CON DOS PESTAÑAS PRINCIPALES -->
        <TabControl Grid.Row="2" Background="White" BorderBrush="#ECF0F1" BorderThickness="1"
                SelectedValuePath="Tag" SelectedValue="{Binding TabItemSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

            <TabControl.Resources>
                <!-- Estilo plano moderno para los encabezados de pestañas -->
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="18,10"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>

            <!-- PESTAÑA 1: INVENTARIO ACTIVO DE REPUESTOS -->
            <TabItem Tag="1" Header="Inventario de Repuestos">
                <Grid Margin="15">
                    <DataGrid x:Name="dgRepuestos" Style="{StaticResource ModernDataGrid}"  RowHeight="30" FontSize="14"
                                  AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeaderWidth="0" GridLinesVisibility="Vertical"  VerticalGridLinesBrush="#eeeeee">

                        <DataGrid.Columns>
                            <!-- Código del Producto -->
                            <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Datos del Repuesto -->
                            <DataGridTextColumn Header="Nombre del Repuesto" Binding="{Binding name}" Width="*"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding category}" Width="180"/>

                            <!-- Stock Mínimo -->
                            <DataGridTextColumn Header="Stock Mínimo" Binding="{Binding minimunStock}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Stock Actual -->
                            <DataGridTextColumn Header="Stock Actual" Binding="{Binding stock}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- COLUMNA DINÁMICA: Estado del Stock (Badge de Advertencia/Éxito) -->
                            <DataGridTemplateColumn Header="Estado Stock" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StockBadge" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock x:Name="StockBadgeText" Style="{StaticResource BadgeTextStyle}"/>
                                        </Border>
                                        <!-- Triggers basados en una propiedad booleana calculada en tu Model (EsBajoStock) -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EsBajoStock}" Value="True">
                                                <Setter TargetName="StockBadge" Property="Background" Value="#FFF9E7"/>
                                                <Setter TargetName="StockBadge" Property="BorderBrush" Value="#F39C12"/>
                                                <Setter TargetName="StockBadge" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="StockBadgeText" Property="Text" Value="⚠️ BAJO STOCK"/>
                                                <Setter TargetName="StockBadgeText" Property="Foreground" Value="#D68910"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EsBajoStock}" Value="False">
                                                <Setter TargetName="StockBadge" Property="Background" Value="#E8F8F5"/>
                                                <Setter TargetName="StockBadge" Property="BorderBrush" Value="#117A65"/>
                                                <Setter TargetName="StockBadge" Property="BorderThickness" Value="1"/>
                                                <Setter TargetName="StockBadgeText" Property="Text" Value="✅ STOCK SEGURO"/>
                                                <Setter TargetName="StockBadgeText" Property="Foreground" Value="#117A65"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- BOTÓN DE ACCIÓN RÁPIDA: Reajustar directamente desde la fila -->
                            <DataGridTemplateColumn Header="Acción" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button x:Name="BtnReajustarFila" Click="BtnReajustarFila_Click" 
                                            Background="#E3F2FD" BorderThickness="0" Cursor="Hand" Padding="8,4" Margin="2">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <fa5:SvgAwesome Icon="Solid_Bolt" Height="10" Foreground="#0D47A1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Reajustar" Foreground="#0D47A1" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 2: HISTORIAL DE AUDITORÍA DE MOVIMIENTOS -->
            <TabItem Tag="2" Header="Historial de Auditoría">
                <Grid Margin="15">
                    <DataGrid x:Name="dgAuditoria" Style="{StaticResource ModernDataGrid}"  RowHeight="30" FontSize="14"
                                  AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeaderWidth="0" GridLinesVisibility="Vertical"  VerticalGridLinesBrush="#eeeeee">

                        <DataGrid.Columns>
                            <!-- Folio de Auditoría -->
                            <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Producto Afectado -->
                            <DataGridTextColumn Header="Producto Reajustado" Binding="{Binding ProductoNombre}" Width="*"/>

                            <!-- Stock Anterior -->
                            <DataGridTextColumn Header="Stock Ant." Binding="{Binding StockAnterior}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- COLUMNA DINÁMICA: Cantidad Ajustada (Verde si suma, Rojo si resta) -->
                            <DataGridTemplateColumn Header="Movimiento" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="AuditBadge" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock x:Name="AuditBadgeText" Text="{Binding CantidadConSigno}" Style="{StaticResource BadgeTextStyle}"/>
                                        </Border>
                                        <!-- Triggers basados en el signo del ajuste (si es incremento o merma) -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EsIncremento}" Value="True">
                                                <Setter TargetName="AuditBadge" Property="Background" Value="#E8F8F5"/>
                                                <Setter TargetName="AuditBadgeText" Property="Foreground" Value="#117A65"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EsIncremento}" Value="False">
                                                <Setter TargetName="AuditBadge" Property="Background" Value="#FDEDEC"/>
                                                <Setter TargetName="AuditBadgeText" Property="Foreground" Value="#C0392B"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Stock Resultante -->
                            <DataGridTextColumn Header="Nuevo Stock" Binding="{Binding StockNuevo}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Notas y Auditoría del Ajuste -->
                            <DataGridTextColumn Header="Motivo del Cambio" Binding="{Binding Motivo}" Width="250"/>
                            <DataGridTextColumn Header="Fecha Ajuste" Binding="{Binding Fecha, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="150"/>
                            <DataGridTextColumn Header="Realizado por" Binding="{Binding UsuarioResponsable}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
