<Page x:Class="WpfApp1.Views.Inventory.BrandAndCategory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BrandAndCategory">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="btnBack" Click="btnBack_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="20" Foreground="#2D2D30"/>
            </Button>
            <StackPanel>
                <TextBlock Text="Clasificación de Inventario" FontSize="24" FontWeight="Bold" Foreground="#2D2D30"/>
                <TextBlock Text="Organice las categorías y marcas para repuestos y artículos comerciales" Foreground="Gray" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">

            <TabItem Padding="15,6">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa5:SvgAwesome Icon="Solid_Tags" Height="12" Foreground="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Categorías" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="Gestionar Categoría" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#3F51B5"/>

                            <TextBlock Text="Nombre de la Categoría" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtCategoryName" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                            <Button x:Name="btnSaveCategory" Content="Guardar Categoría" Height="35" Background="#3F51B5" Foreground="White" FontWeight="Bold" Margin="0,10,0,5" Click="btnSaveCategory_Click"/>
                            <Button x:Name="btnClearCategory" Click="btnClearCategory_Click" Content="Limpiar Campos" Height="35" Background="Transparent" BorderBrush="Gray" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="20,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBox x:Name="txtSearchCategory" Height="35" VerticalContentAlignment="Center" Padding="30,0,10,0"/>
                            <fa5:SvgAwesome Icon="Solid_Search" Height="15" Foreground="Gray" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="dgCategories" AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="60"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding name}" Width="180"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Padding="15,6">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa5:SvgAwesome Icon="Solid_Trademark" Height="12" Foreground="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Marcas" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="Gestionar Marca" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#4CAF50"/>

                            <TextBlock Text="Nombre de la Marca" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtBrandName" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                            <Button x:Name="btnSaveBrand" Content="Guardar Marca" Height="35" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                            <Button x:Name="btnClearBrand" Content="Limpiar Campos" Height="35" Background="Transparent" BorderBrush="Gray"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="20,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBox x:Name="txtSearchBrand" Height="35" VerticalContentAlignment="Center" Padding="30,0,10,0"/>
                            <fa5:SvgAwesome Icon="Solid_Search" Height="15" Foreground="Gray" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="dgBrands" AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="80"/>
                                <DataGridTextColumn Header="Marca de Dispositivo / Accesorio" Binding="{Binding name}" Width="*"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
