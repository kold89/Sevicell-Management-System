<Page x:Class="WpfApp1.Views.Inventory.BrandAndCategory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BrandAndCategory">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="btnBack" Click="btnBack_Click" Background="Transparent" BorderThickness="0"
                    Style="{StaticResource btnGoBackStyle}"
                    Cursor="Hand" 
                    Margin="0,0,15,0">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="20" Foreground="#2196F3"/>
            </Button>
            <StackPanel>
                <TextBlock Text="Clasificación de Inventario" FontSize="24" FontWeight="Bold" Foreground="#2D2D30"/>
                <TextBlock Text="Organice las categorías y marcas para repuestos y artículos comerciales" Foreground="Gray" FontSize="13"/>
            </StackPanel>
        </StackPanel>

        <TabControl SelectedValuePath="Tag" SelectedValue="{Binding TipoDataSeleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">

            <TabItem Tag="1" Padding="15,6">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa5:SvgAwesome Icon="Solid_Tags" Height="12" Foreground="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Categorías" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="Gestionar Categoría" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#3F51B5"/>

                            <TextBlock Text="Nombre de la Categoría" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtCategoryName" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                            <Button x:Name="btnSaveCategory" Content="Guardar Categoría" Height="35" Background="#3F51B5" Foreground="White" FontWeight="Bold" Margin="0,10,0,5" Click="btnSaveCategory_Click"/>
                            <Button x:Name="btnClearCategory" Click="btnClearCategory_Click" Content="Limpiar Campos" Height="35" Background="#aeaeae" BorderBrush="Gray" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="20,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="txtSearchCategory" 
                            Grid.Row="0"
                            Style="{StaticResource SearchTextBoxStyle}" 
                            />      

                        <DataGrid Grid.Row="1" x:Name="dgCategories" Style="{StaticResource ModernDataGrid}"  RowHeight="30" FontSize="14"
                                  AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeaderWidth="0" GridLinesVisibility="Vertical"  VerticalGridLinesBrush="#eeeeee">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="60"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding name}" Width="*"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding status}" Width="*"/>

                                <DataGridTemplateColumn Header="Acciones" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnEditCategory" Click="BtnEditCategory_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="20,0,10,0">
                                                    <fa5:SvgAwesome Icon="Solid_Edit" Height="14" Foreground="Orange"/>
                                                </Button>
                                                <Button x:Name="BtnDisableCategory" Click="BtnDisableCategory_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,0">
                                                    <fa5:SvgAwesome Height="14">
                                                        <fa5:SvgAwesome.Style>
                                                            <Style TargetType="{x:Type fa5:SvgAwesome}">
                                                                <Setter Property="Icon" Value="Solid_Trash" />
                                                                <Setter Property="Foreground" Value="Red" />
                                                                <Setter Property="ToolTip" Value="Dar de baja" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding status}" Value="Deshabilitado">
                                                                        <Setter Property="Icon" Value="Solid_Check" />
                                                                        <Setter Property="Foreground" Value="Green" />
                                                                        <Setter Property="ToolTip" Value="Habilitar usuario" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </fa5:SvgAwesome.Style>
                                                    </fa5:SvgAwesome>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Tag="2" Padding="15,6">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <fa5:SvgAwesome Icon="Solid_Trademark" Height="12" Foreground="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Marcas" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="Gestionar Marca" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#4CAF50"/>

                            <TextBlock Text="Nombre de la Marca" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtBrandName" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                            <Button x:Name="btnSaveBrand" Click="btnSaveBrand_Click" Content="Guardar Marca" Height="35" Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                            <Button x:Name="btnClearBrand" Click="btnClearBrand_Click" Content="Limpiar Campos" Height="35" Background="#aeaeae" BorderBrush="Gray"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="20,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBox x:Name="txtSearchBrand" Style="{StaticResource SearchTextBoxStyle}"/>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="dgBrands" Style="{StaticResource ModernDataGrid}"  RowHeight="30" FontSize="14"
                                  AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowHeaderWidth="0"  GridLinesVisibility="Vertical"  VerticalGridLinesBrush="#eeeeee">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="60"/>
                                <DataGridTextColumn Header="Marca de Dispositivo / Accesorio" Binding="{Binding name}" Width="*"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding status}" Width="*"/>

                                <DataGridTemplateColumn Header="Acciones" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnEditBrand" Click="BtnEditBrand_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="20,0,10,0">
                                                    <fa5:SvgAwesome Icon="Solid_Edit" Height="14" Foreground="Orange"/>
                                                </Button>
                                                <Button x:Name="BtnDisableBrand" Click="BtnDisableBrand_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,0">
                                                    <fa5:SvgAwesome Height="14">
                                                        <fa5:SvgAwesome.Style>
                                                            <Style TargetType="{x:Type fa5:SvgAwesome}">
                                                                <Setter Property="Icon" Value="Solid_Trash" />
                                                                <Setter Property="Foreground" Value="Red" />
                                                                <Setter Property="ToolTip" Value="Dar de baja" />

                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding status}" Value="Deshabilitado">
                                                                        <Setter Property="Icon" Value="Solid_Check" />
                                                                        <Setter Property="Foreground" Value="Green" />
                                                                        <Setter Property="ToolTip" Value="Habilitar usuario" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </fa5:SvgAwesome.Style>
                                                    </fa5:SvgAwesome>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
