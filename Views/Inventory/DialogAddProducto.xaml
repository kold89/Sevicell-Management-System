<Window x:Class="WpfApp1.Views.Inventory.DialogAddProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
        mc:Ignorable="d"
        Background="#FBFBFF"
        WindowStartupLocation="CenterOwner"
        Title="DialogAddProducto" Height="550" Width="420">
    
    <Grid Margin="20,15" Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Margin" Value="0,4,0,12"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0,4,10,12"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Foreground" Value="#4A5568"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </Grid.Resources>

        <TextBlock Grid.Row="0" Name="txtTitle" Text="Agregar Producto" FontFamily="Segoe UI Semibold" FontSize="22" Foreground="#1A202C" Margin="0,0,0,15"></TextBlock>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Código" FontWeight="Bold" FontFamily="Bookman Old Style"/>
                <TextBox x:Name="TxtCodigo"></TextBox>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Nombre de Producto" FontWeight="SemiBold" FontFamily="Bookman Old Style"/>
                <TextBox x:Name="TxtNombre"></TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="2">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Precio de Venta" FontWeight="SemiBold"  FontFamily="Bookman Old Style"/>
                    <TextBox x:Name="TxtPrecioVenta" Width="170"></TextBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Stock Inicial" FontWeight="Bold" FontFamily="Bookman Old Style"/>
                    <TextBox x:Name="TxtStockInicial" Width="170"></TextBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Stock minimo" FontWeight="Bold" FontFamily="Bookman Old Style"/>
                    <TextBox x:Name="TxtStockMinimo" Width="180"></TextBox>
                </StackPanel>
                <CheckBox Content="¿Está activo?" VerticalAlignment="Center" Margin="0,10,0,0" FontFamily="Segoe UI" Foreground="#4A5568"></CheckBox>
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">

                <StackPanel>
                    <TextBlock Text="Estado:" FontWeight="Bold" FontFamily="Bookman Old Style"/>
                    <ComboBox x:Name="CboCategoria" Width="170"></ComboBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Estado:" FontWeight="Bold" FontFamily="Bookman Old Style"/>
                    <ComboBox x:Name="CboProveedor" Width="170"></ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="6">
                <TextBlock Text="Descripción:" FontWeight="Bold" FontFamily="Bookman Old Style"/>
                <TextBox Name="txtDescription" 
                    Height="50" 
                    TextWrapping="Wrap" 
                    AcceptsReturn="True" 
                    VerticalScrollBarVisibility="Auto"></TextBox>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,15,0,0">
            <Button DockPanel.Dock="Right" Content="Guardar" Width="90" Height="34" Margin="8,0,0,0" Foreground="White" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="green" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button DockPanel.Dock="Right" Content="Cancelar" Width="90" Height="34" Foreground="white" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="gray" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>
    </Grid>
</Window>
