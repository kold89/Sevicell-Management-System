<Window x:Class="WpfApp1.Views.Inventory.DialogProductForSee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="DialogProductForSee" Height="450" Width="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Encabezado del producto.-->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Información del Producto" 
                   FontSize="26" 
                   FontWeight="Bold" 
                   Foreground="#2C3E50"/>
            <TextBlock Text="Visualiza y gestiona los detalles técnicos y comerciales de este artículo." 
                   FontSize="13" 
                   Foreground="#7F8C8D" 
                   Margin="0,5,0,0"/>
            <Separator Margin="0,15,0,0" Background="#BDC3C7"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                Background="#F5F6FA" 
                CornerRadius="8" 
                BorderBrush="#DCDDE1" 
                BorderThickness="1" 
                Height="250" 
                VerticalAlignment="Top" 
                Margin="0,0,20,0">
                <Grid>
                    <TextBlock Text="📷 Imagen del Producto" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Foreground="#95A5A6" 
                           FontSize="14"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="5,0">
                <StackPanel Grid.IsSharedSizeScope="True">

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Código:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox Grid.Column="1" Name="txtCode" Text="PROD-10293" IsReadOnly="True" Background="#F8F9FA" Padding="8,5"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nombre:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox Grid.Column="1" Name="txtName" Text="Laptop TechPro 15 pulgadas" IsReadOnly="True" Background="#F8F9FA" Padding="8,5" FontSize="14" FontWeight="Medium"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Categoría:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox Grid.Column="1" Name="txtCategory" Text="Electrónica / Cómputo" IsReadOnly="True" Background="#F8F9FA" Padding="8,5"/>
                        <TextBlock Grid.Column="2" Text="Marca:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="20,0,15,0"/>
                        <TextBox Grid.Column="3" Name="txtBrand" Text="DELL" IsReadOnly="True" Background="#F8F9FA" Padding="8,5"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Precio:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox Grid.Column="1" Name="txtSalesPrice" Text="$1,249.99" IsReadOnly="True" Background="#F8F9FA" Padding="8,5" Foreground="#27AE60" FontWeight="Bold"/>

                        <TextBlock Grid.Column="2" Text="Stock" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="20,0,15,0"/>
                        <TextBox Grid.Column="3" Name="txtStock" Text="45 unidades" IsReadOnly="True" Background="#F8F9FA" Padding="8,5"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Descripción:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Top" Margin="0,5,15,0"/>
                        <TextBox Grid.Column="1" Name="txtDescription" Text="Excelente laptop para desarrollo de software y diseño gráfico. Cuenta con procesador de última generación, 32GB de RAM y 1TB SSD NVMe. Pantalla IPS con alta fidelidad de color." 
                             IsReadOnly="True" Background="#F8F9FA" Padding="8,5" TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnClose" Click="btnClose_Click" Content="Cerrar" Width="100" Height="35" Background="#95A5A6" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
