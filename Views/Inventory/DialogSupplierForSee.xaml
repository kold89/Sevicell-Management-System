<Window x:Class="WpfApp1.Views.Inventory.DialogSupplierForSee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="DialogSupplierForSee" Height="500" Width="480">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Encabezado del producto.-->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Información del Proveedor." 
                   FontSize="26" 
                   FontWeight="Bold" 
                   Foreground="#2C3E50"/>
            <TextBlock Text="Visualiza los detalles del proveedor." 
                   FontSize="13" 
                   Foreground="#7F8C8D" 
                   Margin="0,5,0,0"/>
            <Separator Margin="0,15,0,0" Background="#BDC3C7"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">

                <StackPanel Grid.IsSharedSizeScope="True">

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Código:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox Grid.Column="1" Name="txtCode" Text="PROD-10293" IsReadOnly="True" Background="#F8F9FA" Padding="8,5"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nombre:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox Grid.Column="1" Name="txtName" Text="Laptop TechPro 15 pulgadas" IsReadOnly="True" Background="#F8F9FA" Padding="8,5" FontSize="14" FontWeight="Medium"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Correo:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox Grid.Column="1" Name="txtEmail" Text="Electrónica / Cómputo" IsReadOnly="True" Background="#F8F9FA" Padding="8,5"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Teléfono:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBox Grid.Column="1" Name="txtPhone" Text="$1,249.99" IsReadOnly="True" Background="#F8F9FA" Padding="8,5" Foreground="#27AE60" FontWeight="Bold"/>

                        <TextBlock Grid.Column="2" Text="No. Cta." FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Center" Margin="20,0,15,0"/>
                        <TextBox Grid.Column="3" Name="txtCta" Text="45 unidades" IsReadOnly="True" Background="#F8F9FA" Padding="8,5"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dirección:" FontWeight="SemiBold" Foreground="#34495E" VerticalAlignment="Top" Margin="0,5,15,0"/>
                        <TextBox Grid.Column="1" Name="txtAddres" Text="Excelente laptop para desarrollo de software y diseño gráfico. Cuenta con procesador de última generación, 32GB de RAM y 1TB SSD NVMe. Pantalla IPS con alta fidelidad de color." 
                             IsReadOnly="True" Background="#F8F9FA" Padding="8,5" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    </Grid>

                </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnClose" Click="btnClose_Click" Content="Cerrar" Width="100" Height="35" Background="#95A5A6" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>

</Window>
