<Page x:Class="WpfApp1.Views.Inventory.Products"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Products">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnGoBack" Click="BtnGoBack_Click"  DockPanel.Dock="Left" 
             Background="Transparent" BorderThickness="0" Cursor="Hand">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="20" Foreground="#2196F3"/>
            </Button>

            <StackPanel Margin="15,0,0,0">
                <TextBlock Text="Módulo de Productos" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Dar de Alta y editar datos." Foreground="#777" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"  BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="5,2">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Search" Height="14" Foreground="#BBB" Margin="5,0,10,0"/>
                    <TextBox x:Name="txtBuscar" Grid.Column="1" BorderThickness="0" VerticalContentAlignment="Center"
                          FontSize="14" Foreground="#555" Text="Buscar..."
                        />
                </StackPanel>
            </Border>

            <Button x:Name="BtnAddUser" Click="BtnAddUser_Click" Grid.Column="2" Background="#2196F3" BorderThickness="0" Cursor="Hand" Padding="15,8">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Plus" Height="14" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Nuevo Registro" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <DataGrid x:Name="dgProducts" Grid.Row="2" AutoGenerateColumns="False" Style="{StaticResource ModernDataGrid}" 
               CanUserAddRows="False" HeadersVisibility="Column"
               GridLinesVisibility="All"
               VerticalGridLinesBrush="#aaaaaa"
               HorizontalGridLinesBrush="#aaaaaa"
               BorderThickness="1"
               BorderBrush="#DDDDDD"
               Background="White" RowHeight="30" FontSize="14">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>
                
                <DataGridTextColumn Header="Código" Binding="{Binding code}" Width="auto"/>

                <DataGridTextColumn Header="Nombre de producto" Binding="{Binding name}" Width="*"/>

                <DataGridTextColumn Header="Stock" Binding="{Binding stock}" Width="auto"/>

                <DataGridTextColumn Header="Precio de Venta" Binding="{Binding salesPrice}" Width="150"/>
                <DataGridTextColumn Header="Stock minimo" Binding="{Binding minimunStock}" Width="150"/>

                <DataGridTemplateColumn Header="Acciones" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSee" Click="BtnSee_Click"  Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="20,0,10,0">
                                    <fa5:SvgAwesome Icon="Solid_Eye" Height="14" Foreground="LightGreen"/>
                                </Button>
                                <Button x:Name="BtnEdit" Click="BtnEdit_Click"  Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="20,0,10,0">
                                    <fa5:SvgAwesome Icon="Solid_Edit" Height="14" Foreground="Orange"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
