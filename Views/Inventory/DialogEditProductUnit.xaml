<Window x:Class="WpfApp1.Views.Inventory.DialogEditProductUnit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
        mc:Ignorable="d"
        Title="Editar Datos" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- título -->
            <RowDefinition Height="Auto"/>
            <!-- IMEI -->
            <RowDefinition Height="Auto"/>
            <!-- IMEI2 -->
            <RowDefinition Height="Auto"/>
            <!-- Color -->
            <RowDefinition Height="Auto"/>
            <!-- Modelo -->
            <RowDefinition Height="Auto"/>
            <!-- Estado -->
            <RowDefinition Height="Auto"/>
            <!-- botones -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Editar Unidad" FontSize="20" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="IMEI" FontSize="11" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="2,0,0,3"/>
            <TextBox x:Name="TxtImei1" FontFamily="Consolas"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="IMEI 2" FontSize="11" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="2,0,0,3"/>
            <TextBox x:Name="TxtImei2" FontFamily="Consolas"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="COLOR" FontSize="11" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="2,0,0,3"/>
            <TextBox x:Name="TxtColor"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="MODELO" FontSize="11" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="2,0,0,3"/>
            <TextBox x:Name="TxtModel"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancelar" Content="Cancelar" Width="90" Height="34"
                    Margin="0,0,8,0" Background="Gray" BorderBrush="Transparent"
                    Click="BtnCancelar_Click"/>
            <Button x:Name="BtnSave" Content="Guardar" Width="90" Height="34"
                    Background="#2ECC71" Foreground="White" BorderThickness="0"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
