<Page x:Class="WpfApp1.Views.Inventory.suppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
      xmlns:controles="clr-namespace:WpfApp1.ControlsUI"
      
      mc:Ignorable="d" 
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="suppliersPage">


    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnGoBack" 
        Click="BtnGoBack_Click" 
        DockPanel.Dock="Left" 
        Style="{StaticResource btnGoBackStyle}"
        Cursor="Hand">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="18"/>
            </Button>

            <StackPanel Margin="15,0,0,0">
                <TextBlock Text="Módulo de Proveedores" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Dar de Alta y editar datos." Foreground="#777" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtBuscar" 
         Grid.Column="0"
         Style="{StaticResource SearchTextBoxStyle}" 
         Text="{Binding ProductIdInput, UpdateSourceTrigger=PropertyChanged}"/>

            <Button x:Name="BtnAddSupplier" Click="BtnAddSupplier_Click" Grid.Column="2" Background="#2196F3" BorderThickness="0" Cursor="Hand" Padding="15,8">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Plus" Height="14" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Nuevo Registro" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <DataGrid x:Name="dgSupplier" Grid.Row="2" AutoGenerateColumns="False" Style="{StaticResource ModernDataGrid}" 
                CanUserAddRows="False" HeadersVisibility="Column"
                 GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                 BorderThickness="0"
                 BorderBrush="#DDDDDD"
                 Background="White" RowHeight="44" FontSize="13">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="50"/>

                <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding name}" Width="auto"/>

                <DataGridTextColumn Header="TELEFONO" Binding="{Binding phone}" Width="auto"/>

                <DataGridTextColumn Header="EMAIL" Binding="{Binding email}" Width="150"/>
                <DataGridTextColumn Header="DIRECCION" Binding="{Binding address}" Width="*"/>

                <DataGridTemplateColumn Header="ACCIONES" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSee" Click="BtnSee_Click"  Background="Transparent" BorderThickness="0" Cursor="" Margin="20,0,10,0">
                                    <fa5:SvgAwesome Icon="Solid_Eye" Height="14" Foreground="LightGreen"/>
                                </Button>
                                <Button x:Name="BtnEdit" Click="BtnEdit_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="20,0,10,0">
                                    <fa5:SvgAwesome Icon="Solid_Edit" Height="14" Foreground="Orange"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--<controles:PaginadorControl x:Name="MiPaginador" 
                                Grid.Row="3" 
                                Margin="0,15,0,0"
                                PaginaCambiada="MiPaginador_PaginaCambiada"/>-->
    </Grid>
</Page>
