<Window x:Class="WpfApp1.Views.Inventory.DialogBrandsCategory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
        mc:Ignorable="d"
          WindowStartupLocation="CenterOwner"
        Title="Actualizar información" Height="300" Width="350">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock x:Name="txtSubTitleEdit" Text="Editar  " FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Nombre:" FontWeight="Bold" FontFamily="Bookman Old Style"/>
            <TextBox x:Name="txtNombre" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Estado:" FontWeight="Bold" FontFamily="Bookman Old Style"/>
            <ComboBox x:Name="cbStatus" 
                  Margin="0,5,0,15" 
                  Padding="5"
                  DisplayMemberPath="Name" 
                  SelectedValuePath="Id" />

            <Button x:Name="btnSave" Click="btnSave_Click" Content="Guardar"  
            Background="#2196F3" Foreground="White" Padding="10" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
