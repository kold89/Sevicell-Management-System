<Page x:Class="WpfApp1.Views.Inventory.InvoicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
      xmlns:controles="clr-namespace:WpfApp1"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InvoicePage">

    <Grid Background="#F1F5F9" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,0,20">
                <Button x:Name="BtnGoBack" 
                 Click="BtnGoBack_Click" 
                 DockPanel.Dock="Left" 
                 Style="{StaticResource btnGoBackStyle}"
                 Cursor="Hand">
                 <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="18"/>
                 </Button>

                <StackPanel Margin="15,0,0,0">
                    <TextBlock Text="Ingreso de Factura de Compra" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock Text="Carga de stock al inventario o por adquisiciones formal o informales." Foreground="#777" FontSize="13"/>
                </StackPanel>
            </DockPanel>
            
            <!--<StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="➔" RenderTransformOrigin="0.5,0.5" FontSize="16" Foreground="#475569" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                        <Button.RenderTransform>
                            <RotateTransform Angle="180"/>
                        </Button.RenderTransform>
                    </Button>
                    <TextBlock Text="Ingreso de Factura de Compra" Foreground="#1E293B" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="Carga de stock al inventario de forma formal o por adquisiciones informales." Foreground="#64748B" FontSize="13" Margin="28,0,0,0"/>
            </StackPanel>-->

            <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <CheckBox x:Name="ChkInformal" VerticalAlignment="Center" Cursor="Hand" Checked="ChkInformal_Checked" Unchecked="ChkInformal_Unchecked">
                    <StackPanel Margin="8,-2,0,0">
                        <TextBlock Text="Compra Informal" Foreground="#1E40AF" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Habilitar para compras sin factura ni proveedor" Foreground="#60A5FA" FontSize="11"/>
                    </StackPanel>
                </CheckBox>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtBlockFactura" Text="N° Factura Fiscal" Foreground="#334155" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtInvoiceNumber" Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" FontSize="14" VerticalContentAlignment="Center" Padding="8,0" Margin="0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Setter Property="Text" Value=""/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ChkInformal}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <Grid Grid.Column="1" Margin="12,0,12,0">
                    <StackPanel x:Name="PanelFormal">
                        <TextBlock Text="Proveedor Registrado" Foreground="#334155" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CboProveedor"
                                      DisplayMemberPath="name"
                                      SelectedValuePath="id"
                                  Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="14" VerticalContentAlignment="Center"/>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ChkInformal}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>

                    <StackPanel x:Name="PanelCasual">
                        <TextBlock Text="Nombre del Vendedor Casual" Foreground="#334155" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtSupplierCasual" Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" FontSize="14" VerticalContentAlignment="Center" Padding="8,0"/>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ChkInformal}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <TextBlock Text="Fecha Registro" Foreground="#334155" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <Border x:Name="BorderFecha" Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Cursor="Hand" MouseLeftButtonUp="BorderFecha_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtFechaSeleccionada" Grid.Column="0" Foreground="#1E293B" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <fa5:SvgAwesome Grid.Column="1" Icon="Solid_CalendarAlt" Height="14" Foreground="#64748B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Popup x:Name="PopupCalendario" PlacementTarget="{Binding ElementName=BorderFecha}" Placement="Bottom" StaysOpen="False" IsOpen="False">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="2"/>
                            </Border.Effect>
                            <Calendar x:Name="CalFechaRegistro" SelectedDatesChanged="CalFechaRegistro_SelectedDatesChanged"/>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Escriba descripción o escanee código de barras" Foreground="#475569" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtBuscarProducto" Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" FontSize="14" VerticalContentAlignment="Center" Padding="10,0" TextChanged="TxtBuscarProducto_TextChanged"/>

                        <!-- 👇 Nuevo: Popup de sugerencias -->
                    <Popup x:Name="PopupSugerencias" PlacementTarget="{Binding ElementName=TxtBuscarProducto}"
                        Placement="Bottom" Width="{Binding ActualWidth, ElementName=TxtBuscarProducto}"
                        StaysOpen="False" IsOpen="False">        
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.15" ShadowDepth="2"/>
                                </Border.Effect>
                                <ListBox x:Name="LstSugerencias" MaxHeight="180" BorderThickness="0"
                                SelectionChanged="LstSugerencias_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="8,6">
                                            <TextBlock Text="{Binding code}" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding salesPrice, StringFormat=' - {0:C}'}" Foreground="Gray" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                </StackPanel>

                <Button x:Name="BtnNewProduct" Grid.Column="1" Content="＋" Width="42" Height="38" VerticalAlignment="Bottom" Margin="0,0,12,12" Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#2563EB" FontSize="18" FontWeight="Bold" Cursor="Hand" Click="BtnNewProduct_Click"/>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Cantidad" Foreground="#475569" FontSize="12" Margin="0,0,0,6"/>
                    <controles:IntTexBox x:Name="TxtCant" Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" FontSize="14" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="1"></controles:IntTexBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="Costo Pactado" Foreground="#475569" FontSize="12" Margin="0,0,0,6"/>
                    <controles:PriceTexBox x:Name="TxtPrice" Height="38" Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B" FontSize="14" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Text="0.00"></controles:PriceTexBox>
                </StackPanel>

                <Button Grid.Column="4" Name="BtnAddProduct" Click="BtnAddProduct_Click"  Content="＋ Nuevo Registro" Width="140" Height="38" VerticalAlignment="Bottom" Background="#2563EB" Foreground="White" FontSize="13" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,14"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
            </Border.Effect>
            <DataGrid x:Name="DgPurchaseDetail" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#F8FAFC" BorderThickness="0" Foreground="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="42">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CODIGO" Binding="{Binding Code}" Width="auto"/>
                    <DataGridTextColumn Header="NOMBRE DE PRODUCTO" Binding="{Binding ProductNameVisual}" Width="*"/>
                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"></Setter>
                                <Setter Property="Margin" Value="0,0,20,0"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PRECIO COMPRA" Binding="{Binding PurchasePrice, StringFormat={}{0:N2}}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"></Setter>
                                <Setter Property="Margin" Value="0,0,20,0"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TOTAL LÍNEA" Binding="{Binding TotalItem, StringFormat={}{0:N2}}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Right"></Setter>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="Margin" Value="0,0,20,0"></Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTemplateColumn Header="ACCIONES" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnRemove" Width="25" Style="{StaticResource ActionButtonStyle}"
                                     Height="30"
                                     Margin="5"
                                     Background="#FEF2F2"
                                     BorderBrush="Transparent"
                                     Cursor="Hand"
                                     Click="BtnRemove_Click"
                                     CommandParameter="{Binding}"
                                     ToolTip="Quitar de la lista">
                                        <fa5:SvgAwesome Icon="Solid_Times" Height="14" Foreground="#DC2626"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BnCancel" Click="BnCancel_Click" Content="Cancelar" Width="110" Height="42" Background="White" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,12,0"/>
                <Button x:Name="BtnSaveInvoice" Click="BtnSaveInvoice_Click" Content="💾 Guardar Factura" Width="180" Height="42" Background="#2563EB" Foreground="White" FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Width="260">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Subtotal Factura:" Foreground="#64748B" FontSize="13"/>
                        <TextBlock Text="0" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Margin="0,2,0,6"/>
                    <Grid>
                        <TextBlock Text="TOTAL COMPRA:" Foreground="#1E293B" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txTotal" Text = "0" Foreground="#2563EB" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
