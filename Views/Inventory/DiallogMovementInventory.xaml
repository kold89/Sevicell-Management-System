<Window x:Class="WpfApp1.Views.Inventory.DiallogMovementInventory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Background="#F8F8F8"
        Title="DiallogMovementInventory" Height="400" Width="460">
    <Grid>
        <!-- Formulario simplificado para el Pop-up del Modal -->
        <StackPanel Margin="20" Width="400">
            <TextBlock Text="Ajustar Stock Manual" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
            <Separator Background="#DDDDDD"></Separator>
            <TextBlock Text="Producto Seleccionado:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBox Text="{Binding ProductoSeleccionado.Nombre}" IsReadOnly="True" Background="#F1F5F9" Padding="5"/>

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Tipo de Ajuste:" FontWeight="SemiBold"/>
                    <ComboBox SelectedValue="{Binding TipoAjusteSeleccionado}" SelectedValuePath="Tag" Padding="6">
                        <ComboBoxItem Content="Incrementar (+)" Tag="Incremento"/>
                        <ComboBoxItem Content="Disminuir (-)" Tag="Disminucion"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Cantidad:" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding CantidadAjustar, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Justificación / Motivo del Cambio:" FontWeight="SemiBold" Margin="0,5"/>
            <TextBox Text="{Binding MotivoAjuste, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" Padding="5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar"  Margin="0,0,10,0" Padding="15,5" Background="White" Click="Button_Click"/>
                <Button Content="Guardar" Command="{Binding GuardarAjusteCommand}" Padding="15,5" Background="#2196F3" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
