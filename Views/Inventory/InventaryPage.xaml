<Page x:Class="WpfApp1.Views.Inventory.InventaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Inventory"
       xmlns:fa5="http://schemas.fontawesome.com/icons/"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InventaryPage">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Control Logístico e Inventario" FontSize="28" FontWeight="Bold" Foreground="#2D2D30"/>
            <TextBlock Text="Catálogo maestro de artículos/repuestos, compras y auditoría de stock" Foreground="Gray" FontSize="14"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" VerticalAlignment="Top">

            <Button x:Name="btnProducts" Click="btnProducts_Click" Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_Boxes" Height="50" Foreground="#607D8B" Margin="0,0,0,15"/>
                    <TextBlock Text="Productos y Repuestos" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Alta y administración del producto." Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnCategories" Click="btnCategories_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_Tags" Height="50" Foreground="#3F51B5" Margin="0,0,0,15"/>
                    <TextBlock Text="Categorías y Marcas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Administración de marcas y categorías" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnPurchases" Click="btnPurchases_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_TruckLoading" Height="50" Foreground="#FF9800" Margin="0,0,0,15"/>
                    <TextBlock Text="Entrada por Compras" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ingresar facturas de proveedores" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnStockMovements" Click="btnStockMovements_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_ExchangeAlt" Height="50" Foreground="#70798c" Margin="0,0,0,15"/>
                    <TextBlock Text="Ajustes de Inventario" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Registro de ajustes al inventario" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnSuppliers" Click="btnSuppliers_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_Handshake" Height="50" Foreground="#FF5722" Margin="0,0,0,15"/>
                    <TextBlock Text="Proveedores" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Información de distribuidores mayoristas" Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnInvoiceHistory" Click="btnInvoiceHistory_Click" Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_List" Height="50" Foreground="#0e9594" Margin="0,0,0,15"/>
                    <TextBlock Text="Facturas de compras" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Visualizacion de las facturas de compra." Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnProductUnit" Click="BtnProductUnit_Click"  Style="{StaticResource CardButtonStyle}">
                <StackPanel>
                    <fa5:SvgAwesome Icon="Solid_Toolbox" Height="50" Foreground="#0e9594" Margin="0,0,0,15"/>
                    <TextBlock Text="Ingreso de Telefonos" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Visualizacion de las Telefonos." Foreground="Gray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            
        </UniformGrid>
    </Grid>
</Page>
