<Page x:Class="WpfApp1.Views.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
      mc:Ignorable="d" 
      Background="#F5F7FA"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Dashboard">

    <Page.Resources>
        <!-- Estilos reutilizables -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E8ECF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" 
                                      Opacity="0.04" 
                                      BlurRadius="12" 
                                      ShadowDepth="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="29"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style x:Key="TrendUp" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="FontWeight" Value="Light"/>
        </Style>

        <Style x:Key="TrendDown" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="FontWeight" Value="Light"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="BadgeGreen" TargetType="Border">
            <Setter Property="Background" Value="#EAF3DE"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="6,14"/>
        </Style>

        <Style x:Key="BadgeStatusGreen" TargetType="Border">
            <Setter Property="Background" Value="#EAF3DE"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="BadgeStatusOrange" TargetType="Border">
            <Setter Property="Background" Value="#FFF3E0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="AlertBox" TargetType="Border">
            <Setter Property="Background" Value="#FFFBEB"/>
            <Setter Property="BorderBrush" Value="#FEF3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>

        <Style x:Key="AvatarCircle" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- HEADER                                       -->
            <!-- ============================================ -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="LblGreeting"
                               Text="Buenos días, Admin"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#1A1A2E"/>
                    <TextBlock x:Name="LblDate"
                               Foreground="#6B7280" 
                               FontSize="14"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" 
                        Style="{StaticResource BadgeGreen}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" 
                                 Fill="#4CAF50" 
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Sistema de Administración"
                                   Foreground="#27500A"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================ -->
            <!-- KPI CARDS                                    -->
            <!-- ============================================ -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ventas hoy -->
                <Border Grid.Column="0" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,15,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Ventas hoy" 
                                       Style="{StaticResource KpiLabel}"/>
                            <Border Style="{StaticResource IconCircle}"
                                    Background="#E3F2FD"
                                    DockPanel.Dock="Right">
                                <Path Data="M1,1h4l2.68,13.39a2,2,0,0,0,2,1.61h9.72a2,2,0,0,0,2-1.61L23,6H6"
                                      Stroke="#2196F3" 
                                      StrokeThickness="2" 
                                      Stretch="Uniform"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>

                        <TextBlock Grid.Row="1" 
                                   x:Name="LblSalesToday"
                                   Text="L. 4,820"
                                   Style="{StaticResource KpiValue}"/>

                        <StackPanel Grid.Row="2" 
                                    Orientation="Horizontal">
                            <Path Data="M23,6 L13.5,15.5 L8.5,10.5 L1,18"
                                  Stroke="#4CAF50" 
                                  StrokeThickness="3" 
                                  Stretch="Uniform"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0"/>
                            <TextBlock Text="12% vs ayer" 
                                       Style="{StaticResource TrendUp}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Reparaciones activas -->
                <Border Grid.Column="1" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,15,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Reparaciones activas" 
                                       Style="{StaticResource KpiLabel}"/>
                            <Border Style="{StaticResource IconCircle}"
                                    Background="#FFF3E0"
                                    DockPanel.Dock="Right">
                                <Path Data="M14.7,6.3a1,1,0,0,0,0,1.4l1.6,1.6a1,1,0,0,0,1.4,0l3.77-3.77a6,6,0,0,1-7.94,7.94l-6.91,6.91a2.12,2.12,0,0,1-3-3l6.91-6.91a6,6,0,0,1,7.94-7.94l-3.76,3.76z"
                                      Stroke="#F39C12" 
                                      StrokeThickness="2" 
                                      Stretch="Uniform"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>

                        <TextBlock Grid.Row="1" 
                                   x:Name="LblActiveRepairs"
                                   Text="8"
                                   Style="{StaticResource KpiValue}"/>

                        <TextBlock Grid.Row="2" 
                                   Text="2 sin movimiento"
                                   FontSize="12" 
                                   Foreground="#BA7517" 
                                   FontWeight="Light"/>
                    </Grid>
                </Border>

                <!-- Contratos activos -->
                <Border Grid.Column="2" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,15,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Contratos activos" 
                                       Style="{StaticResource KpiLabel}"/>
                            <Border Style="{StaticResource IconCircle}"
                                    Background="#F3E5F5"
                                    DockPanel.Dock="Right">
                                <Path Data="M1,4 L23,4 L23,20 L1,20 Z M1,10 L23,10"
                                      Stroke="#9B59B6" 
                                      StrokeThickness="2" 
                                      Stretch="Uniform"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>

                        <TextBlock Grid.Row="1" 
                                   x:Name="LblActiveContracts"
                                   Text="23"
                                   Style="{StaticResource KpiValue}"/>

                        <TextBlock Grid.Row="2" 
                                   Text="3 cuotas vencidas"
                                   FontSize="12" 
                                   Foreground="#E74C3C" 
                                   FontWeight="Light"/>
                    </Grid>
                </Border>

                <!-- Stock crítico -->
                <Border Grid.Column="3" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Stock crítico" 
                                       Style="{StaticResource KpiLabel}"/>
                            <Border Style="{StaticResource IconCircle}"
                                    Background="#FFEBEE"
                                    DockPanel.Dock="Right">
                                <Path Data="M21,16V8a2,2,0,0,0-1-1.73l-7-4a2,2,0,0,0-2,0l-7,4A2,2,0,0,0,3,8v8a2,2,0,0,0,1,1.73l7,4a2,2,0,0,0,2,0l7-4A2,2,0,0,0,21,16z M3.27,6.96 L12,12.01 L20.73,6.96 M12,22.08 L12,12"
                                      Stroke="#E74C3C" 
                                      StrokeThickness="2" 
                                      Stretch="Uniform"
                                      Width="18" Height="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>

                        <TextBlock Grid.Row="1" 
                                   x:Name="LblCriticalStock"
                                   Text="4"
                                   Style="{StaticResource KpiValue}"
                                   Foreground="#E74C3C"/>

                        <TextBlock Grid.Row="2" 
                                   Text="productos bajo mínimo"
                                   FontSize="12" 
                                   Foreground="#E74C3C" 
                                   FontWeight="Light"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================ -->
            <!-- CHARTS ROW                                   -->
            <!-- ============================================ -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ventas 7 días -->
                <Border Grid.Column="0" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,15,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ventas — últimos 7 días" 
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Ingresos por ventas de productos" 
                                           Style="{StaticResource SectionSubtitle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" 
                                        HorizontalAlignment="Right">
                                <TextBlock x:Name="LblSalesWeekTotal"
                                           Text="L. 30,820"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#1A1A2E"
                                           HorizontalAlignment="Right"/>
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right"
                                            Margin="0,4,0,0">
                                    <Path Data="M23,6 L13.5,15.5 L8.5,10.5 L1,18"
                                          Stroke="#4CAF50" 
                                          StrokeThickness="3" 
                                          Stretch="Uniform"
                                          Width="10" Height="10"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"/>
                                    <TextBlock Text="8% vs semana anterior" 
                                               Style="{StaticResource TrendUp}"
                                               FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Aquí irá el gráfico de ScottPlot -->
                        <Border Grid.Row="1" 
                                x:Name="SalesChartPlaceholder"
                                Height="180"
                                Background="#FAFBFC"
                                CornerRadius="10"
                                BorderBrush="#E8ECF0"
                                BorderThickness="1">
                            <TextBlock Text="[Gráfico de ventas — ScottPlot]"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#9CA3AF"
                                       FontSize="14"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Reparaciones 7 días -->
                <Border Grid.Column="1" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Reparaciones — últimos 7 días" 
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Ingresos por servicios de reparación" 
                                           Style="{StaticResource SectionSubtitle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" 
                                        HorizontalAlignment="Right">
                                <TextBlock x:Name="LblRepairsWeekTotal"
                                           Text="L. 12,400"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="#1A1A2E"
                                           HorizontalAlignment="Right"/>
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Right"
                                            Margin="0,4,0,0">
                                    <Path Data="M23,18 L13.5,8.5 L8.5,13.5 L1,6"
                                          Stroke="#E74C3C" 
                                          StrokeThickness="3" 
                                          Stretch="Uniform"
                                          Width="10" Height="10"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"/>
                                    <TextBlock Text="3% vs semana anterior" 
                                               Style="{StaticResource TrendDown}"
                                               FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Aquí irá el gráfico de ScottPlot -->
                        <Border Grid.Row="1" 
                                x:Name="RepairsChartPlaceholder"
                                Height="180"
                                Background="#FAFBFC"
                                CornerRadius="10"
                                BorderBrush="#E8ECF0"
                                BorderThickness="1">
                            <TextBlock Text="[Gráfico de reparaciones — ScottPlot]"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#9CA3AF"
                                       FontSize="14"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================ -->
            <!-- BOTTOM ROW                                   -->
            <!-- ============================================ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>

                <!-- Estado reparaciones -->
                <Border Grid.Column="0" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,15,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                   Text="Estado de reparaciones" 
                                   Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Row="1" 
                                   Text="Distribución actual" 
                                   Style="{StaticResource SectionSubtitle}"
                                   Margin="0,4,0,20"/>

                        <!-- Donut chart placeholder -->
                        <Border Grid.Row="2" 
                                x:Name="StatusChartPlaceholder"
                                Height="180"
                                Background="#FAFBFC"
                                CornerRadius="10"
                                BorderBrush="#E8ECF0"
                                BorderThickness="1"
                                Margin="0,0,0,16">
                            <TextBlock Text="[Gráfico donut — ScottPlot]"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#9CA3AF"
                                       FontSize="14"/>
                        </Border>

                        <!-- Leyenda -->
                        <StackPanel Grid.Row="2" 
                                    Margin="0,200,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" 
                                           Width="10" Height="10" 
                                           Fill="#2196F3" 
                                           RadiusX="3" RadiusY="3"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                           Text="En curso" 
                                           FontSize="13" 
                                           Foreground="#374151"/>
                                <TextBlock Grid.Column="2" 
                                           x:Name="LblStatusInProgress"
                                           Text="5" 
                                           FontSize="13" 
                                           FontWeight="Light" 
                                           Foreground="#1A1A2E"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" 
                                           Width="10" Height="10" 
                                           Fill="#F39C12" 
                                           RadiusX="3" RadiusY="3"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                           Text="Esperando piezas" 
                                           FontSize="13" 
                                           Foreground="#374151"/>
                                <TextBlock Grid.Column="2" 
                                           x:Name="LblStatusWaiting"
                                           Text="2" 
                                           FontSize="13" 
                                           FontWeight="UltraBlack" 
                                           Foreground="#1A1A2E"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" 
                                           Width="10" Height="10" 
                                           Fill="#4CAF50" 
                                           RadiusX="3" RadiusY="3"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                           Text="Listos para entrega" 
                                           FontSize="13" 
                                           Foreground="#374151"/>
                                <TextBlock Grid.Column="2" 
                                           x:Name="LblStatusReady"
                                           Text="1" 
                                           FontSize="13" 
                                           FontWeight="Light"
                                           Foreground="#1A1A2E"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Listos para entrega -->
                <Border Grid.Column="1" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Listos para entrega" 
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Equipos reparados esperando al cliente" 
                                           Style="{StaticResource SectionSubtitle}"/>
                            </StackPanel>

                            <Border Grid.Column="1" 
                                    Style="{StaticResource BadgeGreen}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="LblReadyCount"
                                           Text="2 equipos"
                                           Foreground="#27500A"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- Lista de equipos -->
                        <StackPanel Grid.Row="1" x:Name="ReadyList">

                            <!-- Item 1 -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Style="{StaticResource AvatarCircle}"
                                        Background="#E3F2FD"
                                        Margin="0,0,14,0">
                                    <TextBlock Text="JP" 
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#2196F3"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" 
                                            VerticalAlignment="Center">
                                    <TextBlock Text="iPhone 12 — Juan Pérez" 
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1A1A2E"/>
                                    <TextBlock Text="Pantalla rota · Téc. Carlos · Lista hace 2 horas" 
                                               FontSize="12" Foreground="#6B7280"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" 
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="L. 850" 
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#1A1A2E"
                                               HorizontalAlignment="Right"/>
                                    <Border Style="{StaticResource BadgeStatusGreen}"
                                            Margin="0,4,0,0">
                                        <TextBlock Text="✓ Listo" 
                                                   Foreground="#27500A"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Separator Background="#F3F4F6" 
                                       Margin="0,16" 
                                       Height="1"/>

                            <!-- Item 2 -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Style="{StaticResource AvatarCircle}"
                                        Background="#FFF3E0"
                                        Margin="0,0,14,0">
                                    <TextBlock Text="MR" 
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#F39C12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" 
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Samsung S21 — Mario Reyes" 
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1A1A2E"/>
                                    <TextBlock Text="Batería · Téc. Luis · Lista desde ayer" 
                                               FontSize="12" Foreground="#6B7280"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" 
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="L. 450" 
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#1A1A2E"
                                               HorizontalAlignment="Right"/>
                                    <Border Style="{StaticResource BadgeStatusOrange}"
                                            Margin="0,4,0,0">
                                        <TextBlock Text="⏱ 1 día" 
                                                   Foreground="#BA7517"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Alerta -->
                            <Border Style="{StaticResource AlertBox}">
                                <StackPanel Orientation="Horizontal">
