<Page x:Class="WpfApp1.Views.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d" 
      Background="Black"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="LblGreeting"
                               Text="Buenos días, Admin"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#333"/>
                    <TextBlock x:Name="LblDate"
                               Foreground="#777" FontSize="13"/>
                </StackPanel>
                <Border DockPanel.Dock="Right"
                        Background="#EAF3DE"
                        CornerRadius="12"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <fa5:SvgAwesome Icon="Solid_CheckCircle"
                                        Height="12" Foreground="#27500A"
                                        Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sistema operativo"
                                   Foreground="#27500A" FontSize="12"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Métricas -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ventas hoy -->
                <Border Grid.Column="0" Background="#F8F8F8"
                        CornerRadius="8" Padding="16" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Ventas hoy" FontSize="11"
                                       Foreground="#888"/>
                            <fa5:SvgAwesome Icon="Solid_ShoppingCart"
                                            Height="14" Foreground="#2196F3"
                                            HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="LblSalesToday"
                                   Text="L. 4,820"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#333"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    Margin="0,4,0,0">
                            <fa5:SvgAwesome Icon="Solid_ArrowUp"
                                            Height="10" Foreground="#27500A"
                                            Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="12% vs ayer"
                                       FontSize="11" Foreground="#27500A"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Reparaciones activas -->
                <Border Grid.Column="1" Background="#F8F8F8"
                        CornerRadius="8" Padding="16" Margin="5,0,5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Reparaciones activas"
                                       FontSize="11" Foreground="#888"/>
                            <fa5:SvgAwesome Icon="Solid_Tools"
                                            Height="14" Foreground="#F39C12"
                                            HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="LblActiveRepairs"
                                   Text="8"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#333"/>
                        <TextBlock Grid.Row="2" Text="2 sin movimiento"
                                   FontSize="11" Foreground="#BA7517"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <!-- Contratos -->
                <Border Grid.Column="2" Background="#F8F8F8"
                        CornerRadius="8" Padding="16" Margin="5,0,5,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Contratos activos"
                                       FontSize="11" Foreground="#888"/>
                            <fa5:SvgAwesome Icon="Solid_CreditCard"
                                            Height="14" Foreground="#9B59B6"
                                            HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="LblActiveContracts"
                                   Text="23"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#333"/>
                        <TextBlock Grid.Row="2" Text="3 cuotas vencidas"
                                   FontSize="11" Foreground="#E74C3C"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <!-- Stock crítico -->
                <Border Grid.Column="3" Background="#F8F8F8"
                        CornerRadius="8" Padding="16" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Stock crítico"
                                       FontSize="11" Foreground="#888"/>
                            <fa5:SvgAwesome Icon="Solid_Box"
                                            Height="14" Foreground="#E74C3C"
                                            HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="LblCriticalStock"
                                   Text="4"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#E74C3C"/>
                        <TextBlock Grid.Row="2" Text="productos bajo mínimo"
                                   FontSize="11" Foreground="#E74C3C"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Fila 2: Gráficas ventas y reparaciones -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ventas 7 días -->
                <Border Grid.Column="0" Background="White"
                        BorderBrush="#EEEEEE" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="Ventas — últimos 7 días"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#333"/>
                                <TextBlock Text="Ingresos por ventas de productos"
                                           FontSize="11" Foreground="#888"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="L. 30,820"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#333"
                                           HorizontalAlignment="Right"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <fa5:SvgAwesome Icon="Solid_ArrowUp"
                                                    Height="10" Foreground="#27500A"
                                                    Margin="0,0,3,0"
                                                    VerticalAlignment="Center"/>
                                    <TextBlock Text="8% vs semana anterior"
                                               FontSize="11" Foreground="#27500A"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <lvc:CartesianChart x:Name="SalesChart"
                                            Height="160"
                                            TooltipPosition="Hidden"/>
                    </StackPanel>
                </Border>

                <!-- Reparaciones 7 días -->
                <Border Grid.Column="1" Background="White"
                        BorderBrush="#EEEEEE" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="10,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="Reparaciones — últimos 7 días"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#333"/>
                                <TextBlock Text="Ingresos por servicios de reparación"
                                           FontSize="11" Foreground="#888"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="L. 12,400"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#333"
                                           HorizontalAlignment="Right"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <fa5:SvgAwesome Icon="Solid_ArrowDown"
                                                    Height="10" Foreground="#E74C3C"
                                                    Margin="0,0,3,0"
                                                    VerticalAlignment="Center"/>
                                    <TextBlock Text="3% vs semana anterior"
                                               FontSize="11" Foreground="#E74C3C"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <lvc:CartesianChart x:Name="RepairChart"
                                            Height="160"
                                            TooltipPosition="Hidden"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Fila 3: Estado reparaciones + Listos para entrega -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>

                <!-- Estado reparaciones -->
                <Border Grid.Column="0" Background="White"
                        BorderBrush="#EEEEEE" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Estado de reparaciones"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#333"/>
                        <TextBlock Text="Distribución actual"
                                   FontSize="11" Foreground="#888"
                                   Margin="0,2,0,12"/>
                        <lvc:CartesianChart x:Name="RepairStateChart"
                                            Height="160"
                                            TooltipPosition="Hidden"/>
                    </StackPanel>
                </Border>

                <!-- Listos para entrega -->
                <Border Grid.Column="1" Background="White"
                        BorderBrush="#EEEEEE" BorderThickness="1"
                        CornerRadius="8" Padding="16" Margin="10,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Listos para entrega"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#333"/>
                                <TextBlock Text="Equipos reparados esperando al cliente"
                                           FontSize="11" Foreground="#888"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right"
                                    Background="#EAF3DE"
                                    CornerRadius="10" Padding="10,3"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="LblReadyCount"
                                           Text="2 equipos"
                                           Foreground="#27500A"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>

                        <!-- Lista equipos -->
                        <StackPanel x:Name="ReadyList">
                            <!-- Item 1 -->
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                                    Padding="0,10">
                                <DockPanel>
                                    <Border Width="36" Height="36"
                                            CornerRadius="18"
                                            Background="#EAF3DE"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="JP" Foreground="#27500A"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Right"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="L. 850"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#333"
                                                   HorizontalAlignment="Right"/>
                                        <Border Background="#EAF3DE"
                                                CornerRadius="10" Padding="8,2"
                                                HorizontalAlignment="Right"
                                                Margin="0,4,0,0">
                                            <TextBlock Text="Listo"
                                                       Foreground="#27500A"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="iPhone 12 — Juan Pérez"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#333"/>
                                        <TextBlock Text="Pantalla rota · Téc. Carlos · Lista hace 2 horas"
                                                   FontSize="11" Foreground="#888"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Item 2 -->
                            <Border Padding="0,10">
                                <DockPanel>
                                    <Border Width="36" Height="36"
                                            CornerRadius="18"
                                            Background="#E6F1FB"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="MR" Foreground="#185FA5"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Right"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="L. 450"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#333"
                                                   HorizontalAlignment="Right"/>
                                        <Border Background="#FAEEDA"
                                                CornerRadius="10" Padding="8,2"
                                                HorizontalAlignment="Right"
                                                Margin="0,4,0,0">
                                            <TextBlock Text="1 día"
                                                       Foreground="#854F0B"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Samsung S21 — Mario Reyes"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#333"/>
                                        <TextBlock Text="Batería · Téc. Luis · Lista desde ayer"
                                                   FontSize="11" Foreground="#888"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Alerta -->
                            <Border Background="#FFF8E1" CornerRadius="6"
                                    Padding="10" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <fa5:SvgAwesome Icon="Solid_Bell"
                                                    Height="12" Foreground="#BA7517"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"/>
                                    <TextBlock Text="Samsung S21 lleva 1 día esperando — considera contactar al cliente."
                                               FontSize="11" Foreground="#854F0B"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Estado vacío -->
                        <StackPanel x:Name="EmptyState"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    Margin="0,30,0,30">
                            <Border Width="52" Height="52"
                                    CornerRadius="26"
                                    Background="#F8F8F8"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,12">
                                <fa5:SvgAwesome Icon="Solid_CheckCircle"
                                                Height="26" Foreground="#27500A"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Todo entregado"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#333"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="No hay equipos esperando entrega en este momento."
                                       FontSize="12" Foreground="#888"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </ScrollViewer>
</Page>
