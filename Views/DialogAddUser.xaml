<Window x:Class="WpfApp1.Views.DialogAddUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Formulario" Height="500" Width="400">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Registrar Nuevo Usuario" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Nombres:"/>
            <TextBox x:Name="txtNombre" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Apellidos:"/>
            <TextBox x:Name="txtLasName" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Nombre de Usuario (Login):"/>
            <TextBox x:Name="txtLogin" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Contraseña:"/>
            <PasswordBox x:Name="txtPass" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Rol de Usuario:"/>
            <ComboBox x:Name="cbRoles" 
                  Margin="0,5,0,15" 
                  Padding="5"
                  DisplayMemberPath="NombreRol" 
                  SelectedValuePath="IdRol" />  

            <Button x:Name="btnGuardar" Content="Guardar Usuario"  
            Background="#2196F3" Foreground="White" Padding="10" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
