<Page x:Class="WpfApp1.Views.Catalog.CustomersListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Views.Catalog"
      xmlns:ctrl="clr-namespace:WpfApp1.ControlsUI"
      xmlns:fa5="http://schemas.fontawesome.com/icons/"

      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Clientes">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnGoBack" Click="BtnGoBack_Click"  DockPanel.Dock="Left" 
                    Style="{StaticResource btnGoBackStyle}" Cursor="Hand">
                <fa5:SvgAwesome Icon="Solid_ArrowLeft" Height="20" Foreground="#2196F3"/>
            </Button>

            <StackPanel Margin="15,0,0,0">
                <TextBlock Text="Módulo de Clientes" FontSize="22" FontWeight="Bold" Foreground="#333"/>
                <TextBlock Text="Administre y visualice la información de los Clientes." Foreground="#777" FontSize="13"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtBuscar" Grid.Column="0"
                 Style="{StaticResource SearchTextBoxStyle}"
                 TextChanged="txtBuscar_TextChanged"/>

            <Button x:Name="BtnAddCustomers" Click="BtnAddCustomers_Click"  
                    Grid.Column="2" Background="#2196F3" BorderThickness="0" 
                    Cursor="Hand" Padding="15,8">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Plus" Height="14" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Nuevo Registro" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.04" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <DataGrid x:Name="dgCustomers" MouseDoubleClick="dgCustomers_MouseDoubleClick"
                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0" Foreground="#1E293B" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" HeadersVisibility="Column"
                      AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="42"
                      IsReadOnly="True">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="NOMBRE" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="EMAIL" Binding="{Binding Mail}" Width="200"/>
                        <DataGridTextColumn Header="TELEFONO" Binding="{Binding Phone}" Width="170"/>
                        <DataGridTextColumn Header="DIRECCIÓN" Binding="{Binding Address}" Width="220"/>
                        <DataGridTemplateColumn Header="ACCIONES" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnEdit" Click="BtnEdit_Click"
                                            Tag="{Binding Id}" ToolTip="Editar Cliente"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Margin="20,0,10,0">
                                            <fa5:SvgAwesome Icon="Solid_Edit" Height="14" Foreground="Orange"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="pnlEmpty" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                    <fa5:SvgAwesome Icon="Solid_UserSlash" Height="36" Foreground="#CBD5E1"/>
                    <TextBlock x:Name="txtEmpty" Text="No se encontraron clientes."
                       Foreground="#94A3B8" FontSize="14" Margin="0,12,0,0"
                       HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtResumen" Grid.Column="0" Margin="4,0,0,0"
               VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>

            <ctrl:PaginadorControl x:Name="Paginador" Grid.Column="1"
                           RegistrosPorPagina="10"
                           PaginaCambiada="Paginador_PaginaCambiada"/>
        </Grid>
    </Grid>

</Page>
