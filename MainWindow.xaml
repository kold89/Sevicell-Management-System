<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Mi primer app WPF" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
       
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo -->
        <Border Background="#1E3A8A" Grid.Column="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="SEVICELL" FontSize="32" Foreground="White" FontWeight="Bold" FontFamily="Segoe UI"  HorizontalAlignment="Center"/>
                <TextBlock Text="Sistema de Inventario" FontSize="16" Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI"  Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Panel derecho -->
        <Grid Grid.Column="1" Background="#F3F4F6">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">

                <TextBlock Text="Iniciar Sesión" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <!-- Usuario -->
                <TextBlock Text="Usuario" FontFamily="Segoe UI"  FontSize="14"/>
                <TextBox x:Name="txtUsuario" Height="30" Margin="0,5,0,15" Padding="5"/>

                <!-- Contraseña -->
                <TextBlock Text="Contraseña" FontFamily="Segoe UI" FontSize="14"/>
                <PasswordBox x:Name="txtPassword" Height="30" Margin="0,5,0,20" Padding="5"/>

                <!-- Botón -->
                <!-- Botón Mejorado -->
                <Border CornerRadius="10" Background="#1E3A8A" 
        Effect="{DynamicResource DropShadowEffect}" 
        SnapsToDevicePixels="True">
                    <Border.Resources>
                        <!-- Sombra ligera -->
                        <DropShadowEffect x:Key="DropShadowEffect" Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Resources>

                    <Button Content="Ingresar" Click="btnIngresar"
            Height="35" 
            Background="Transparent"  
            Foreground="White" 
            FontWeight="Bold"
            BorderThickness="0"
            Cursor="Hand"
            FocusVisualStyle="{x:Null}">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="35"/>

                                <Style.Triggers>
                                    <!-- Hover: cambia el color -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </Trigger>

                                    <!-- Presionado: efecto oscuro -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1B2A8F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>

                <!-- Mensaje -->
                <TextBlock x:Name="lblMensageError" Foreground="Red" Margin="0,10,0,0" TextAlignment="Center"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
