<Window x:Class="WpfApp1.main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        mc:Ignorable="d"
        Title="Panel Administrativo-SEVICELL" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Menú -->
            <ColumnDefinition Width="*"/>
            <!-- Contenido -->
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Barra superior -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Background="#2D2D30">
            <TextBlock Text="LOGO" Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"></TextBlock>
            
        </Grid>

        <!-- 🔹 Menú lateral -->
        <StackPanel Grid.Row="1" Grid.Column="0" Background="#2D2D30">
            <Button Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Home" Height="16" Foreground="White" Margin="0,0,15,0"/>
                    <TextBlock Text="Inicio" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_ShoppingCart" Height="16" Foreground="White" Margin="0,0,15,0"/>
                    <TextBlock Text="Ventas" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Tools" Height="16" Foreground="White" Margin="0,0,15,0"/>
                    <TextBlock Text="Reparaciones" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Box" Height="16" Foreground="White" Margin="0,0,15,0"/>
                    <TextBlock Text="Inventario" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_ChartBar" Height="16" Foreground="White" Margin="0,0,15,0"/>
                    <TextBlock Text="Reportes" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnConfiguraciones" Click="btnConfiguraciones_Click" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Icon="Solid_Cog" Height="16" Foreground="White" Margin="0,0,15,0"/>
                    <TextBlock Text="Configuraciones" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 🔹 Barra superior -->
        <Grid Grid.Column="1" Grid.Row="0" Background="#1E1E1E">
            <DockPanel Margin="10">
                <TextBlock Text="SEVICELL PRO" FontSize="16" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Bienvenido," FontSize="15" Foreground="Gray" Margin="0,0,7,0"/>
                    <TextBlock Name="LblUserName" FontSize="15"  Text="Usuario" Foreground="SkyBlue" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- 🔹 Contenido dinámico -->
        <Grid Grid.Column="1" Grid.Row="1" Background="#F5F5F5">
            <Frame Name="MainFrame" 
           NavigationUIVisibility="Hidden" 
           BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>
