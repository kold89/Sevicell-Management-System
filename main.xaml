<Window x:Class="WpfApp1.main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
         xmlns:services="clr-namespace:WpfApp1.Services"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"
        Loaded="Window_Loaded"
        mc:Ignorable="d"
        Title="Panel Administrativo-SEVICELL" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="250"/>
            <!-- Menú -->
            <ColumnDefinition Width="*"/>
            <!-- Contenido -->
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <!-- Barra superior -->
            <RowDefinition Height="*"/>
            <!-- Contenido -->
        </Grid.RowDefinitions>

        <!-- Barra del LOGO + Botón de menú hamburguesa -->
        <Grid Grid.Column="0" Grid.Row="0" Background="#2D2D30">
            <DockPanel Margin="10,0">
                <!-- 2. Botón para encoger/expandir -->
                <ToggleButton x:Name="BtnToggleMenu" 
                          Click="BtnToggleMenu_Click"
                          DockPanel.Dock="Left"
                          Width="32" Height="32" 
                          Background="Transparent" BorderThickness="0" 
                          Cursor="Hand">
                    <fa5:SvgAwesome Icon="Solid_Bars" Foreground="White" Width="16" Height="16"/>
                </ToggleButton>

                <!-- El texto del logo (se ocultará automáticamente si no cabe) -->
                <TextBlock x:Name="TxtLogo" Text="LOGO" Foreground="White"
                       VerticalAlignment="Center" HorizontalAlignment="Center" 
                       FontWeight="Bold" Margin="10,0,0,0"/>
            </DockPanel>
        </Grid>

        <!-- 🔹 Menú lateral (StackPanel) -->
        <StackPanel  Grid.Row="1" Grid.Column="0" Background="#2D2D30">

            <!-- Inicio -->
            <RadioButton Name="BtnDashboard" ToolTip="Inicio" Checked="BtnDashboard_Checked" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Style="{StaticResource MenuIconStyle}" Icon="Solid_Home" Height="16" Margin="0,0,15,0"/>
                    <!-- 3. Envolvemos el texto en este contenedor con Nombre para ocultarlo -->
                    <StackPanel x:Name="PanelTextInicio" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuTextStyle}" Text="Inicio" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>

            <!-- Ventas -->
            <RadioButton x:Name="BtnSales" Click="BtnSales_Click" ToolTip="Ventas" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Style="{StaticResource MenuIconStyle}" Icon="Solid_ShoppingCart" Height="16" Margin="0,0,15,0"/>
                    <StackPanel x:Name="PanelTextVentas" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuTextStyle}" Text="Ventas" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>

            <!-- Créditos -->
            <RadioButton x:Name="BtnCredits" ToolTip="Créditos" Click="BtnCredits_Click" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Style="{StaticResource MenuIconStyle}" Icon="Solid_FileContract" Height="16" Margin="0,0,15,0"/>
                    <StackPanel x:Name="PanelTextCreditos" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuTextStyle}" Text="Créditos" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>

            <!-- Reparaciones -->
            <RadioButton x:Name="btnRepairs" ToolTip="Reparaciones" Click="btnRepairs_Click" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Style="{StaticResource MenuIconStyle}" Icon="Solid_Tools" Height="16" Margin="0,0,15,0"/>
                    <StackPanel x:Name="PanelTextReparaciones" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuTextStyle}" Text="Reparaciones" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>

            <!-- Inventario -->
            <RadioButton x:Name="BtnInventory" ToolTip="Inventario" Click="BtnInventory_Click" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Style="{StaticResource MenuIconStyle}" Icon="Solid_Box" Height="16" Margin="0,0,15,0"/>
                    <StackPanel x:Name="PanelTextInventario" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuTextStyle}" Text="Inventario" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>

            <!-- Reportes -->
            <RadioButton x:Name="BtnReports" ToolTip="Reportes" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Style="{StaticResource MenuIconStyle}" Icon="Solid_ChartBar" Height="16" Margin="0,0,15,0"/>
                    <StackPanel x:Name="PanelTextReportes" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuTextStyle}" Text="Reportes" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>

            <!-- Configuraciones -->
            <RadioButton x:Name="btnConfiguraciones" ToolTip="Configuraciones" Click="btnConfiguraciones_Click" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <fa5:SvgAwesome Style="{StaticResource MenuIconStyle}" Icon="Solid_Cog" Height="16" Margin="0,0,15,0"/>
                    <StackPanel x:Name="PanelTextConfig" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuTextStyle}" Text="Configuraciones" VerticalAlignment="Center" FontSize="14" FontFamily="Segoe UI Semibold"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>

        </StackPanel>
        <!-- 🔹 Barra superior -->
        <Grid Grid.Column="1" Grid.Row="0" Background="#1E1E1E">
            <DockPanel Margin="10">
                <TextBlock Text="SEVICELL PRO" FontSize="16" Foreground="White" 
                   FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <!-- Controles derechos -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                    VerticalAlignment="Center" DockPanel.Dock="Right">

                    <!-- Bienvenido -->
                    <TextBlock Text="Bienvenido," FontSize="15" Foreground="Gray" 
                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Name="LblUserName" FontSize="15" Text="Usuario" 
                       Foreground="SkyBlue" FontWeight="SemiBold" 
                       VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <!-- 🔔 Botón Campana -->
                    <Grid VerticalAlignment="Center" Margin="0,0,15,0">
                        <Button x:Name="BtnNotifications"
                        Click="BtnNotifications_Click"
                        Width="36" Height="36"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Notificaciones">
                            <fa5:SvgAwesome Icon="Solid_Bell" 
                                    Foreground="White" 
                                    Width="18" Height="18"/>
                        </Button>

                        <!-- Badge contador -->
                        <Ellipse x:Name="BadgeEllipse"
                         Width="16" Height="16"
                         Fill="#E74C3C"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Visibility="Collapsed"/>
                        <TextBlock x:Name="BadgeCount"
                           Text="0"
                           Foreground="White"
                           FontSize="9"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,0,1,0"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
                    </Grid>

                    <!-- ⏻ Logout -->
                    <Button x:Name="BtnLogout"
                    Click="BtnLogout_Click"
                    Width="36" Height="36"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Cerrar sesión">
                        <fa5:SvgAwesome Icon="Solid_SignOutAlt" 
                                Foreground="#E74C3C" 
                                Width="18" Height="18"/>
                    </Button>

                </StackPanel>
            </DockPanel>
            <!-- 🔔 Popup de notificaciones -->
            <Popup x:Name="NotificationPopup"
           PlacementTarget="{Binding ElementName=BtnNotifications}"
           Placement="Bottom"
           StaysOpen="False"
           AllowsTransparency="True">
                <Border Background="White" 
                BorderBrush="#DDDDDD" 
                BorderThickness="1"
                CornerRadius="6"
                Width="300"
                Effect="{StaticResource ShadowEffect}">
                    <StackPanel>

                        <!-- Header -->
                        <Border Background="#1E1E1E" CornerRadius="6,6,0,0" Padding="12,8">
                            <TextBlock Text="🔔 Notificaciones" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="13"/>
                        </Border>

                        <!-- Lista de notificaciones -->
                        <ItemsControl x:Name="NotificationsList" MaxHeight="280">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" 
                                               FontWeight="SemiBold" 
                                               FontSize="12" 
                                               Foreground="#2D2D30"/>
                                            <TextBlock Text="{Binding Message}" 
                                               FontSize="11" 
                                               Foreground="#666" 
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding TimeAgo}" 
                                               FontSize="10" 
                                               Foreground="#E74C3C"
                                               Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Sin notificaciones -->
                        <TextBlock x:Name="NoNotificationsText"
                           Text="Sin notificaciones nuevas"
                           Foreground="Gray"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Padding="12,16"
                           Visibility="Visible"/>

                        <!-- Footer -->
                        <Border Background="#F9F9F9" CornerRadius="0,0,6,6" Padding="12,8">
                            <Button Content="Marcar todas como leídas"
                            Click="BtnMarkAllRead_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="SkyBlue"
                            FontSize="11"
                            Cursor="Hand"
                            HorizontalAlignment="Center"/>
                        </Border>

                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- 🔹 Contenido dinámico -->
        <Grid Grid.Column="1" Grid.Row="1" Background="#F5F5F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="478*"/>
                <ColumnDefinition Width="73*"/>
            </Grid.ColumnDefinitions>
            <Frame Name="MainFrame" 
           NavigationUIVisibility="Hidden" 
           BorderThickness="0" Grid.ColumnSpan="2"
           Navigated="MainFrame_Navigated"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding Source={x:Static services:ToastService.Toasts}}"
                      Grid.Row="0" Grid.RowSpan="2"
                      Grid.Column="0" Grid.ColumnSpan="2"
                      Panel.ZIndex="999"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,20,20"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding BackgroundColor}"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,8"
                            MinWidth="280"
                            IsHitTestVisible="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</Window>
